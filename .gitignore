*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Model weights and other large binaries (fetched by scripts, never committed)
models/
*.gguf
*.safetensors

# Regenerable computation caches
data/pharmacy/xtb-cache/

# OS
.DS_Store

