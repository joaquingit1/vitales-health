{
  "$defs": {
    "AllowedUse": {
      "enum": [
        "risk_context",
        "patient_instruction",
        "routine_basis",
        "limit_basis"
      ],
      "type": "string"
    },
    "CardMembership": {
      "properties": {
        "card": {
          "$ref": "#/$defs/PathwayCard"
        },
        "uses": {
          "items": {
            "$ref": "#/$defs/UseStatus"
          },
          "title": "Uses",
          "type": "array"
        },
        "clinical_review": {
          "enum": [
            "clinically_reviewed",
            "not_clinically_reviewed"
          ],
          "title": "Clinical Review",
          "type": "string"
        }
      },
      "required": [
        "card",
        "uses",
        "clinical_review"
      ],
      "title": "CardMembership",
      "type": "object",
      "additionalProperties": false
    },
    "DiscrepancyInput": {
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "claim_rev_sha256": {
          "title": "Claim Rev Sha256",
          "type": "string"
        },
        "superseded": {
          "$ref": "#/$defs/SpanRef"
        },
        "current": {
          "$ref": "#/$defs/SpanRef"
        },
        "relation": {
          "enum": [
            "contradicts",
            "revises"
          ],
          "title": "Relation",
          "type": "string"
        },
        "recorded_by": {
          "title": "Recorded By",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "claim_rev_sha256",
        "superseded",
        "current",
        "relation",
        "recorded_by"
      ],
      "title": "DiscrepancyInput",
      "type": "object",
      "additionalProperties": false
    },
    "Extraction": {
      "properties": {
        "extraction_id": {
          "title": "Extraction Id",
          "type": "string"
        },
        "document_version_id": {
          "title": "Document Version Id",
          "type": "string"
        },
        "format_version": {
          "title": "Format Version",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "text_sha256": {
          "title": "Text Sha256",
          "type": "string"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/PageRange"
          },
          "title": "Pages",
          "type": "array"
        },
        "page_map_sha256": {
          "title": "Page Map Sha256",
          "type": "string"
        },
        "extracted_by": {
          "title": "Extracted By",
          "type": "string"
        }
      },
      "required": [
        "extraction_id",
        "document_version_id",
        "format_version",
        "text",
        "text_sha256",
        "pages",
        "page_map_sha256",
        "extracted_by"
      ],
      "title": "Extraction",
      "type": "object",
      "additionalProperties": false
    },
    "LicenseRecord": {
      "properties": {
        "license_id": {
          "title": "License Id",
          "type": "string"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "nasa_public_domain",
            "permission_documented",
            "metadata_only"
          ],
          "title": "Kind",
          "type": "string"
        },
        "permission_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Permission Basis"
        },
        "recorded_by": {
          "title": "Recorded By",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "license_id",
        "content_sha256",
        "kind",
        "permission_basis",
        "recorded_by",
        "at"
      ],
      "title": "LicenseRecord",
      "type": "object",
      "additionalProperties": false
    },
    "MemberSnapshot": {
      "properties": {
        "passage": {
          "$ref": "#/$defs/PassageArtifact"
        },
        "extraction": {
          "$ref": "#/$defs/Extraction"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "license": {
          "$ref": "#/$defs/LicenseRecord"
        },
        "uses": {
          "items": {
            "$ref": "#/$defs/UseStatus"
          },
          "title": "Uses",
          "type": "array"
        },
        "clinical_review": {
          "enum": [
            "clinically_reviewed",
            "not_clinically_reviewed"
          ],
          "title": "Clinical Review",
          "type": "string"
        },
        "environments": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "title": "Environments"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "withdrawn": {
          "title": "Withdrawn",
          "type": "boolean"
        },
        "simulation_only": {
          "title": "Simulation Only",
          "type": "boolean"
        }
      },
      "required": [
        "passage",
        "extraction",
        "source_ids",
        "license",
        "uses",
        "clinical_review",
        "environments",
        "section",
        "withdrawn",
        "simulation_only"
      ],
      "title": "MemberSnapshot",
      "type": "object",
      "additionalProperties": false
    },
    "PageRange": {
      "properties": {
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "char_start": {
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "title": "Char End",
          "type": "integer"
        }
      },
      "required": [
        "page",
        "char_start",
        "char_end"
      ],
      "title": "PageRange",
      "type": "object",
      "additionalProperties": false
    },
    "PassageArtifact": {
      "properties": {
        "passage_id": {
          "title": "Passage Id",
          "type": "string"
        },
        "extraction_id": {
          "title": "Extraction Id",
          "type": "string"
        },
        "char_start": {
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "title": "Char End",
          "type": "integer"
        },
        "text_sha256": {
          "title": "Text Sha256",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "page_start": {
          "title": "Page Start",
          "type": "integer"
        },
        "page_end": {
          "title": "Page End",
          "type": "integer"
        }
      },
      "required": [
        "passage_id",
        "extraction_id",
        "char_start",
        "char_end",
        "text_sha256",
        "text",
        "page_start",
        "page_end"
      ],
      "title": "PassageArtifact",
      "type": "object",
      "additionalProperties": false
    },
    "PathwayCard": {
      "properties": {
        "condition_id": {
          "title": "Condition Id",
          "type": "string"
        },
        "indicative_assessment": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            ],
            "type": "array"
          },
          "title": "Indicative Assessment",
          "type": "array"
        },
        "workup_source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Workup Source Ids",
          "type": "array"
        },
        "supporting_passage_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Passage Ids",
          "type": "array"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "authored_by": {
          "title": "Authored By",
          "type": "string"
        },
        "authored": {
          "title": "Authored",
          "type": "boolean"
        },
        "simulation_only": {
          "title": "Simulation Only",
          "type": "boolean"
        },
        "environments": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "title": "Environments"
        }
      },
      "required": [
        "condition_id",
        "indicative_assessment",
        "workup_source_ids",
        "supporting_passage_ids",
        "content_sha256",
        "authored_by",
        "authored",
        "simulation_only",
        "environments"
      ],
      "title": "PathwayCard",
      "type": "object",
      "additionalProperties": false
    },
    "SpanRef": {
      "properties": {
        "release_id": {
          "title": "Release Id",
          "type": "string"
        },
        "passage_id": {
          "title": "Passage Id",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "passage_id"
      ],
      "title": "SpanRef",
      "type": "object",
      "additionalProperties": false
    },
    "UseStatus": {
      "properties": {
        "use": {
          "$ref": "#/$defs/AllowedUse"
        },
        "status": {
          "enum": [
            "approved",
            "superseded",
            "withdrawn"
          ],
          "title": "Status",
          "type": "string"
        },
        "approval_ref": {
          "title": "Approval Ref",
          "type": "string"
        },
        "successor_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Successor Ref"
        }
      },
      "required": [
        "use",
        "status",
        "approval_ref",
        "successor_ref"
      ],
      "title": "UseStatus",
      "type": "object",
      "additionalProperties": false
    }
  },
  "properties": {
    "memberships": {
      "items": {
        "$ref": "#/$defs/MemberSnapshot"
      },
      "title": "Memberships",
      "type": "array"
    },
    "cards": {
      "items": {
        "$ref": "#/$defs/CardMembership"
      },
      "title": "Cards",
      "type": "array"
    },
    "discrepancies": {
      "items": {
        "$ref": "#/$defs/DiscrepancyInput"
      },
      "title": "Discrepancies",
      "type": "array"
    }
  },
  "required": [
    "memberships",
    "cards",
    "discrepancies"
  ],
  "title": "ReleaseContent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-content.schema.json",
  "additionalProperties": false
}
