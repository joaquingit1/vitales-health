{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-policy.schema.json",
  "title": "ReleasePolicyInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance", "purposes", "segmentation", "tracking_parameters", "source_hierarchy"],
  "properties": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "source_ids", "responsible_author"],
      "properties": {
        "basis": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(EV|RT|RS|SK|S|C|N|L)[0-9]{2}$"}},
        "responsible_author": {"type": "string", "minLength": 1}
      }
    },
    "purposes": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["use", "source_kinds", "completeness", "partial_acknowledgment_required"],
        "properties": {
          "use": {"enum": ["risk_context", "patient_instruction", "routine_basis", "limit_basis"]},
          "source_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "completeness": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["full", "partial"]}},
          "partial_acknowledgment_required": {"type": "boolean"}
        }
      }
    },
    "segmentation": {
      "type": "object", "additionalProperties": false,
      "required": ["min_words", "max_words", "overlap_words"],
      "properties": {
        "min_words": {"type": "integer", "minimum": 1},
        "max_words": {"type": "integer", "minimum": 1},
        "overlap_words": {"type": "integer", "minimum": 0}
      }
    },
    "tracking_parameters": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_hierarchy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
