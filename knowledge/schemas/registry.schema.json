{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RegistryInput.schema.json",
  "title": "RegistryInput",
  "type": "object",
  "properties": {
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConditionInput"
      }
    },
    "memberships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MembershipInput"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DeclaredSourceInput"
      }
    },
    "families": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/FamilyInput"
      }
    }
  },
  "required": [
    "input_manifest_sha256",
    "conditions",
    "memberships",
    "sources",
    "families"
  ],
  "additionalProperties": false,
  "$defs": {
    "ConditionInput": {
      "type": "object",
      "properties": {
        "condition_id": {
          "type": "string",
            "pattern": "^ICL[1-9][0-9]{0,2}[A-Z]?$",
            "description": "Raw inventory identity preserves source suffixes. Public API validation remains separate."
        },
        "condition": {
          "type": "string"
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "optional_inputs": {
          "type": "string"
        },
        "clinical_assessment": {
          "type": "string"
        },
        "equipment": {
          "type": "string"
        },
        "current_stack": {
          "type": "string"
        },
        "limitations": {
          "type": "string"
        },
        "nasa_membership_source": {
          "type": "string"
        },
        "workup_source_ids": {
          "type": "string"
        },
        "evidence_status": {
          "type": "string"
        },
        "software_release": {
          "type": "string"
        },
        "clinical_execution": {
          "type": "string"
        },
        "workup_source_scope": {
          "type": "string"
        },
        "worked_entry": {
          "type": "string"
        }
      },
      "required": [
        "condition_id",
        "condition",
        "family",
        "optional_inputs",
        "clinical_assessment",
        "equipment",
        "current_stack",
        "limitations",
        "nasa_membership_source",
        "workup_source_ids",
        "evidence_status",
        "software_release",
        "clinical_execution",
        "workup_source_scope",
        "worked_entry"
      ],
      "additionalProperties": false
    },
    "MembershipInput": {
      "type": "object",
      "properties": {
        "source_entry_id": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "source_inventory": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "published_mapping": {
          "type": "string"
        },
        "active_match": {
          "type": "string"
        },
        "planning_family": {
          "type": "string"
        },
        "mapping_status": {
          "type": "string"
        },
        "optional_inputs": {
          "type": "string"
        },
        "assessment_plan": {
          "type": "string"
        },
        "limitation": {
          "type": "string"
        },
        "coverage": {
          "type": "string"
        },
        "review_status": {
          "type": "string"
        }
      },
      "required": [
        "source_entry_id",
        "condition",
        "source_inventory",
        "source_url",
        "published_mapping",
        "active_match",
        "planning_family",
        "mapping_status",
        "optional_inputs",
        "assessment_plan",
        "limitation",
        "coverage",
        "review_status"
      ],
      "additionalProperties": false
    },
    "DeclaredSourceInput": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^(EV|RT|RS|SK|S|C|N|L)\\d{2}$"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "declaring_input": {
          "type": "string"
        },
        "date_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "saved_as": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source_id",
        "title",
        "url",
        "declaring_input",
        "date_text",
        "access_text",
        "saved_as"
      ],
      "additionalProperties": false
    },
    "FamilyInput": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "optional_inputs": {
          "type": "string"
        },
        "exam": {
          "type": "string"
        },
        "indicative_tests": {
          "type": "string"
        },
        "limitations": {
          "type": "string"
        },
        "source_ids": {
          "type": "string"
        },
        "equipment": {
          "type": "string"
        },
        "review_status": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "optional_inputs",
        "exam",
        "indicative_tests",
        "limitations",
        "source_ids",
        "equipment",
        "review_status"
      ],
      "additionalProperties": false
    }
  }
}
