{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-map.schema.json",
  "title": "StageMapInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provenance",
    "methods"
  ],
  "properties": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "source_ids",
        "responsible_author"
      ],
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "responsible_author": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "ceiling"
        ],
        "properties": {
          "method": {
            "enum": [
              "http_fetch",
              "file_import",
              "audit_pdf",
              "package_saved_text",
              "exa_contents"
            ]
          },
          "ceiling": {
            "enum": [
              "full",
              "partial",
              "summary_only",
              "inaccessible"
            ]
          }
        }
      }
    }
  }
}
