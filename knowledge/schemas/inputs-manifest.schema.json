{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "InputsManifest.schema.json",
  "title": "InputsManifest",
  "type": "object",
  "properties": {
    "provenance": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "responsible_author": {
          "type": "string"
        }
      },
      "required": [
        "basis",
        "source_ids",
        "responsible_author"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "enum": [
              "docs/product/condition-assessments-119.json",
              "docs/product/condition-assessments-119.csv",
              "docs/product/expanded-inventory-assessments-792.csv",
              "docs/product/assessment-families.json",
              "docs/product/sources.csv",
              "docs/product/NASA-SOURCES.md",
              "docs/product/RESEARCH-ANNEX.md"
            ]
          },
          "destination": {
            "enum": [
              "knowledge/inputs/package/condition-assessments-119.json",
              "knowledge/inputs/package/condition-assessments-119.csv",
              "knowledge/inputs/package/expanded-inventory-assessments-792.csv",
              "knowledge/inputs/package/assessment-families.json",
              "knowledge/inputs/package/sources.csv",
              "knowledge/inputs/package/NASA-SOURCES.md",
              "knowledge/inputs/package/RESEARCH-ANNEX.md"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "parser": {
            "enum": [
              "json",
              "csv",
              "md"
            ]
          }
        },
        "required": [
          "source",
          "destination",
          "sha256",
          "parser"
        ],
        "additionalProperties": false
      }
    },
    "unavailable": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "provenance",
    "files",
    "unavailable"
  ],
  "additionalProperties": false
}
