              },
              "uniqueItems": true
            },
            "to_be_set_by": {
              "enum": [
                "clinical review",
                "the flight surgeon",
                "flight rules",
                null
              ]
            }
          },
          "required": [
            "basis",
            "source_ids",
            "to_be_set_by"
          ],
          "additionalProperties": false
        },
        "sample": {
          "type": "object",
          "properties": {
            "basis": {
