{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medqa-proxy.schema.json",
  "title": "MedQA proxy benchmark plan (model validation of a general medical knowledge proxy; not clinical validation)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label",
    "dataset",
    "model",
    "runtime",
    "generation",
    "sample",
    "bounds"
  ],
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "revision",
        "file",
        "url",
        "sha256",
        "size_bytes",
        "examples",
        "license",
        "license_basis",
        "citation",
        "letters"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://huggingface\\.co/datasets/[^?#]+/resolve/[0-9a-f]{40}/[^?#]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "examples": {
          "type": "integer",
          "minimum": 0
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "license_basis": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "letters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_name",
        "weights_sha256",
        "source",
        "basis",
        "chat_template_sha256",
        "binary_sha256",
        "runtime_build",
        "runtime_commit",
        "runtime_basis"
      ],
      "properties": {
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "weights_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "chat_template_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_build": {
          "type": "string",
          "minLength": 1
        },
        "runtime_commit": {
          "type": "string",
          "minLength": 1
        },
        "runtime_basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_tokens",
        "threads",
        "gpu_layers",
        "kv_cache_type",
        "load_timeout_s",
        "health_poll_s"
      ],
      "properties": {
        "context_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "threads": {
          "type": "integer",
          "minimum": 0
        },
        "gpu_layers": {
          "type": "integer",
          "minimum": 0
        },
        "kv_cache_type": {
          "type": "string",
          "minLength": 1
        },
        "load_timeout_s": {
          "type": "integer",
          "minimum": 0
        },
        "health_poll_s": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "top_k",
        "seed",
        "max_tokens",
        "enable_thinking",
        "item_timeout_s",
        "system",
        "answer_instruction"
      ],
      "properties": {
        "temperature": {
          "type": "integer",
          "minimum": 0
        },
        "top_k": {
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "enable_thinking": {
          "type": "boolean"
        },
        "item_timeout_s": {
          "type": "integer",
          "minimum": 0
        },
        "system": {
          "type": "string",
          "minLength": 1
        },
        "answer_instruction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "max_n",
        "warmup_n"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "max_n": {
          "type": "integer",
          "minimum": 0
        },
        "warmup_n": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_line_bytes",
        "max_response_chars",
        "connect_timeout_s"
      ],
      "properties": {
        "max_line_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_response_chars": {
          "type": "integer",
          "minimum": 0
        },
        "connect_timeout_s": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
