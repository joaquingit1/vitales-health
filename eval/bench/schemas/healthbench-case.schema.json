{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HealthBenchCase",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt_id", "prompt", "rubrics", "example_tags"],
  "properties": {
    "prompt_id": {"type": "string", "minLength": 1},
    "prompt": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/message"}},
    "rubrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rubric"}},
    "example_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "ideal_completions_data": {"type": ["object", "null"]},
    "canary": {"type": ["string", "null"]}
  },
  "$defs": {
    "message": {
      "title": "HealthBenchMessage", "type": "object", "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {"role": {"type": "string", "minLength": 1}, "content": {"type": "string"}}
    },
    "rubric": {
      "title": "HealthBenchRubric", "type": "object", "additionalProperties": false,
      "required": ["criterion", "points", "tags"],
      "properties": {"criterion": {"type": "string", "minLength": 1},
        "points": {"type": "number"},
        "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}
    }
  }
}
