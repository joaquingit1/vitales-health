{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "prompt_sha256": {
      "type": "string",
      "minLength": 1
    },
    "tool_catalog_sha256": {
      "type": "string",
      "minLength": 1
    },
    "case_set_sha256": {
      "type": "string",
      "minLength": 1
    },
    "evidence_release_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_sha256": {
      "type": "string",
      "minLength": 1
    },
    "config_release_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "preregistration_sha256": {
      "type": "string",
      "minLength": 1
    },
    "dataset_sha256": {
      "type": "object"
    },
    "harness": {
      "type": "object"
    },
    "model_release": {
      "type": "object"
    },
    "bench_documents_sha256": {
      "type": "object"
    },
    "grader": {
      "type": "object"
    },
    "decoding": {
      "type": "object"
    },
    "hardware": {
      "type": "object"
    },
    "software": {
      "type": "object"
    },
    "partition": {
      "enum": [
        "dev",
        "holdout",
        "benchmark"
      ]
    },
    "repeats": {
      "type": "integer",
      "minimum": 1
    },
    "track": {
      "enum": [
        "model_only",
        "system_assisted",
        "rules_only"
      ]
    },
    "variant": {
      "enum": [
        "main",
        "Hard",
        "Consensus",
        null
      ]
    },
    "completeness": {
      "enum": [
        "full",
        "subset",
        "partial"
      ]
    },
    "integrity": {
      "enum": [
        "official",
        "modified"
      ]
    },
    "n": {
      "type": "integer",
      "minimum": 0
    },
    "N": {
      "type": "integer",
      "minimum": 0
    },
    "reviewer_qualification": {
      "enum": [
        "engineering"
      ]
    },
    "claim_class": {
      "enum": [
        "public_benchmark"
      ]
    },
    "benchmark_disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "reported"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "model_pin": {
      "type": "object"
    },
    "harness_version": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "condition_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "error",
              "timeout",
              "missing"
            ]
          }
        },
        "required": [
          "scenario_id",
          "condition_id",
          "outcome"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "suite",
    "prompt_sha256",
    "tool_catalog_sha256",
    "case_set_sha256",
    "evidence_release_id",
    "evidence_sha256",
    "config_release_id",
    "seed",
    "preregistration_sha256",
    "dataset_sha256",
    "harness",
    "model_release",
    "bench_documents_sha256",
    "grader",
    "decoding",
    "hardware",
    "software",
    "partition",
    "repeats",
    "track",
    "variant",
    "completeness",
    "integrity",
    "n",
    "N",
    "reviewer_qualification",
    "run_id",
    "release_id",
    "state",
    "status",
    "registry_version",
    "model_pin",
    "harness_version",
    "scenarios"
  ],
  "additionalProperties": false
}
