uv run --project hub python -m crew_health.contracts_gen.build
COVERAGE_FILE=/tmp/e10.coverage uv run --project hub pytest -c hub/pyproject.toml -q hub/tests/knowledge --cov=crew_health.knowledge.domain --cov=crew_health.knowledge.application --cov-branch --cov-config=hub/pyproject.toml --cov-fail-under=95 --junitxml=/tmp/e10-tests.xml
uv run --project hub ruff check --config hub/pyproject.toml hub/src/crew_health/knowledge hub/tests/knowledge knowledge/scripts
uv run --project hub ruff format --config hub/pyproject.toml --check hub/src/crew_health/knowledge hub/tests/knowledge knowledge/scripts
uv run --project hub mypy --config-file hub/pyproject.toml --strict hub/src/crew_health/knowledge knowledge/scripts
uv run --project hub python -m crew_health.app.import_contracts --output /tmp/e10-imports.ini
uv run --project hub lint-imports --config /tmp/e10-imports.ini
uv run --project hub python scripts/validate_hub.py corpus
uv run --project hub python knowledge/scripts/validate.py
uv run --project hub pytest -c hub/pyproject.toml -q eval/scenarios/e10
uv pip compile hub/pyproject.toml --python-platform x86_64-pc-windows-msvc --only-binary :all: --output-file /tmp/e10-windows.txt
