uv run --project hub --locked pytest -c hub/pyproject.toml -q hub/tests/tools --cov=crew_health.tools.domain --cov=crew_health.tools.application --cov-config=hub/pyproject.toml --cov-branch --cov-fail-under=95 --cov-report=term-missing --cov-report=json:/tmp/crew-health-e12-owned-coverage.json
uv run --project hub --locked ruff check --config hub/pyproject.toml hub/src/crew_health/tools hub/tests/tools
uv run --project hub --locked ruff format --check --config hub/pyproject.toml hub/src/crew_health/tools hub/tests/tools
uv run --project hub --locked mypy --config-file hub/pyproject.toml --strict hub/src/crew_health/tools
uv run --project hub --locked python -m crew_health.app.import_contracts --output /tmp/crew-health-e12-T1-imports.ini
uv run --project hub --locked lint-imports --config /tmp/crew-health-e12-T1-imports.ini
