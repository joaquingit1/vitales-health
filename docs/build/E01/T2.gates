uv run --project hub python -m crew_health.contracts_gen.build
pnpm -C packages/contracts-ts generate
uv run --project hub pytest -c hub/pyproject.toml -q hub/tests/kernel hub/tests/platform hub/tests/config hub/tests/clock hub/tests/events hub/tests/records hub/tests/app hub/tests/contracts/test_e01_contracts.py hub/tests/contracts/test_sha_guard.py eval/scenarios/E01
uv run --project hub ruff check --config hub/pyproject.toml hub/src/crew_health/__init__.py hub/src/crew_health/kernel hub/src/crew_health/platform hub/src/crew_health/config hub/src/crew_health/clock hub/src/crew_health/events hub/src/crew_health/records hub/src/crew_health/app hub/src/crew_health/contracts_gen/__init__.py hub/src/crew_health/contracts_gen/build.py scripts/validate_hub.py hub/tests/kernel hub/tests/platform hub/tests/config hub/tests/clock hub/tests/events hub/tests/records hub/tests/app hub/tests/contracts/test_e01_contracts.py hub/tests/contracts/test_sha_guard.py eval/scenarios/E01
uv run --project hub ruff format --check --config hub/pyproject.toml hub/src/crew_health/__init__.py hub/src/crew_health/kernel hub/src/crew_health/platform hub/src/crew_health/config hub/src/crew_health/clock hub/src/crew_health/events hub/src/crew_health/records hub/src/crew_health/app hub/src/crew_health/contracts_gen/__init__.py hub/src/crew_health/contracts_gen/build.py scripts/validate_hub.py hub/tests/kernel hub/tests/platform hub/tests/config hub/tests/clock hub/tests/events hub/tests/records hub/tests/app hub/tests/contracts/test_e01_contracts.py hub/tests/contracts/test_sha_guard.py eval/scenarios/E01
uv run --project hub mypy --config-file hub/pyproject.toml --strict hub/src/crew_health/__init__.py hub/src/crew_health/kernel hub/src/crew_health/platform hub/src/crew_health/config hub/src/crew_health/clock hub/src/crew_health/events hub/src/crew_health/records hub/src/crew_health/app hub/src/crew_health/contracts_gen/__init__.py hub/src/crew_health/contracts_gen/build.py scripts/validate_hub.py
uv run --project hub python -m crew_health.app.import_contracts --output "${TMPDIR:-/tmp}/e01-t2-imports.ini"
uv run --project hub lint-imports --config "${TMPDIR:-/tmp}/e01-t2-imports.ini"
pnpm -C packages/contracts-ts typecheck
