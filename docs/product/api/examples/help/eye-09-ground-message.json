      "question": null,
      "answers": [],
      "flow": {
        "title": "Eye injury or something in the eye",
        "plain": "Something got into the eye or hit it. Dust from the Moon or Mars is sharp and can scratch the eye. Rinse it. Do not rub it.",
        "immediate_steps": [
          {
            "index": 0,
            "text": "Do not rub the eye.",
            "ticked_at": "2026-11-13T12:02:50Z",
            "ticked_by": {
              "kind": "person",
              "id": "mara",
              "display_name": "Mara Okafor"
            }
          },
          {
            "index": 1,
            "text": "If an object is stuck in the eye, do not remove it. Cover the eye with a rigid shield that rests on the bone around the eye, not on the eye.",
            "ticked_at": null,
            "ticked_by": null
          },
          {
            "index": 2,
            "text": "Chemical, dust or grit in the eye: hold the eye open and rinse with lots of clean water at once, for at least 20 minutes.",
            "ticked_at": "2026-11-13T12:03:05Z",
            "ticked_by": {
              "kind": "person",
              "id": "mara",
              "display_name": "Mara Okafor"
            }
          },
          {
            "index": 3,
            "text": "In weightlessness, water and dust float. Use the onboard eye wash set. Until it is ready, rinse with a drink bag and soak up the water with towels.",
            "ticked_at": "2026-11-13T12:03:20Z",
            "ticked_by": {
              "kind": "person",
              "id": "mara",
              "display_name": "Mara Okafor"
            }
          },
          {
            "index": 4,
            "text": "Call the CMO.",
            "ticked_at": null,
            "ticked_by": null
          }
        ],
        "questions": [
          "What got in, or what hit the eye?",
          "Was it a chemical, dust from outside, or a sharp object?",
          "Can you see as well as before with that eye?",
          "Pain, light hurting, or a gritty feeling?",
          "Contact lenses in?"
        ],
        "measurements": [
          {
            "what": "Sight in each eye",
            "how": "Cover the other eye. Read the same text on the screen with each eye and record any difference. Test card and distance: to be set by clinical review.",
            "instrument": "app screen"
          },
          {
            "what": "Photo of the eye",
            "how": "A still, close photo in good light for the CMO, kept with the log for the ground. Do not touch the eye.",
            "instrument": "camera station"
          }
        ],
        "treatment_steps": [
          {
            "step": "Rinse with lots of clean water",
            "who": "any crew",
            "kit": "eye wash set, drink bag, towels"
          },
          {
            "step": "Rigid shield over an eye with something stuck in it, with no pressure on the eye",
            "who": "any crew",
            "kit": "eye shield, if listed"
          },
          {
            "step": "Remove a loose particle and check the eye surface for scratches, as in the onboard procedure",
            "who": "crew medical officer",
            "kit": "as in the onboard procedure"
          },
          {
            "step": "Eye medicines, as in the onboard procedure",
            "who": "crew medical officer",
            "kit": "as in the onboard procedure"
          },
          {
            "step": "Follow up check by a crewmate: look at the eye and ask about sight at the next check (interval to be set by clinical review), with a photo kept for the log",
            "who": "any crew",
            "kit": "camera station"
          },
          {
            "step": "Log for the ground with the photos, for a later diagnosis of eye damage. It leaves at the next contact; nothing waits for it.",
            "who": "ground",
            "kit": "message link with photos"
          }
        ],
        "call_ground_when": "Log for the ground at once for something stuck in the eye, a chemical in the eye, or any change in sight; otherwise when pain or grittiness does not settle after rinsing (how long to wait: to be set by clinical review). It leaves at the next contact; nothing here waits for it.",
        "environment_note": "Lunar dust is very abrasive and can injure the eye. Dust carried inside can float in a vehicle in weightlessness.",
        "body_regions": [
          "eyes"
        ],
        "citation": {
