{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ingest-result.schema.json",
  "title": "IngestResult",
  "description": "Result of an adapter batch. Each reading is accepted, a duplicate (same channel and adapter_sequence, ignored) or rejected with a code.",
  "type": "object",
  "properties": {
    "batch_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "accepted": {
      "type": "integer",
      "minimum": 0
    },
    "duplicates": {
      "type": "integer",
      "minimum": 0
    },
    "reading_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "code": {
            "enum": [
              "MALFORMED_REQUEST",
              "UNAUTHENTICATED",
              "UNAUTHORIZED_SCOPE",
              "CONSENT_REQUIRED",
              "ACTION_NOT_ALLOWED",
              "ADAPTER_NOT_TRUSTED",
              "AGGREGATE_ONLY",
              "NOT_FOUND",
              "STALE_VERSION",
              "INVALID_TRANSITION",
              "DUPLICATE_COMMAND",
              "SESSION_CLOSED",
              "CONFIG_VERSION_MISMATCH",
              "CONFIRMATION_REQUIRED",
              "CURSOR_EXPIRED",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "INVALID_UNIT",
              "INVALID_VALUE",
              "IDENTITY_MISMATCH",
              "ORIGIN_MISMATCH",
              "KIT_CANNOT_PERFORM",
              "CAPABILITY_UNAVAILABLE",
              "CONTEXT_INAPPLICABLE",
              "SOURCE_NOT_APPROVED",
              "REPORT_UNCONFIRMED",
              "LEVEL_NOT_ALLOWED",
              "APPROVAL_REQUIRED",
              "CONFIG_INVALID",
              "STEP_NOT_AVAILABLE",
              "SUPPLY_BELOW_ZERO",
              "ROLE_NOT_ELIGIBLE",
              "VERSION_REQUIRED",
              "INTERNAL_ERROR",
              "MALFORMED_MODEL_OUTPUT",
              "MODEL_OUTPUT_REJECTED",
              "MODEL_UNAVAILABLE",
              "MODEL_TIMEOUT"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "index",
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "evaluations_changed": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/config_id"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "batch_id",
    "accepted",
    "duplicates",
    "reading_ids",
    "rejected",
    "evaluations_changed"
  ],
  "additionalProperties": false
}
