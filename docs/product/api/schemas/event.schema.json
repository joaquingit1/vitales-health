        "properties": {
          "data": {
            "$ref": "sensor-channel.schema.json"
          },
          "scope": {
            "properties": {
              "kind": {
                "enum": [
                  "habitat",
                  "operator"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "warning.raised"
          }
        }
      },
