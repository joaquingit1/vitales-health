        "properties": {
          "data": {
            "$ref": "warning.schema.json"
          },
          "scope": {
            "properties": {
              "kind": {
                "enum": [
                  "person",
                  "habitat",
                  "crew"
                ]
              }
            }
          }
        }
      }
    },
    {
