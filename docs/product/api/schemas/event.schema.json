{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Event",
  "description": "One event on GET /v1/events (CONTRACTS section 18). seq is a hub-wide, strictly increasing integer and is also the SSE id.",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "type": {
      "enum": [
        "config.release_activated",
        "environment.change_proposed",
        "environment.activated",
        "environment.change_rejected",
        "overlay.changed",
        "mission.event_recorded",
        "ground_link.changed",
        "sensor.status_changed",
        "sensor.quiet",
        "sensor.resumed",
        "warning.raised",
        "warning.updated",
        "warning.cleared",
        "routine.occurrence_changed",
        "routine.override_changed",
        "help.session_changed",
        "help.broadcast_changed",
        "ground_message.changed",
        "assistant.status_changed",
        "insight.changed",
        "job.progress",
        "measurement_request.changed",
        "handoff.changed",
        "participation.streak_changed",
        "participation.crew_goal_changed",
        "plan_run.changed",
        "plan_run.step_done",
        "plan_run.escalated",
        "guided_check.beat",
        "guided_check.checked",
        "coaching.sample",
        "role.proposed",
        "role.changed",
        "skill.practiced",
        "supply.used",
        "drill.changed"
      ]
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/instant"
    },
    "emitted_at": {
      "$ref": "common.schema.json#/$defs/instant"
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "person",
            "habitat",
            "crew",
            "ground",
            "operator"
          ]
        },
        "person_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/environment_id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "person_id",
        "environment_id"
      ],
      "additionalProperties": false
    },
    "config_release_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "correlation_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "seq",
    "event_id",
    "type",
    "occurred_at",
    "emitted_at",
    "scope",
    "config_release_id",
    "correlation_id",
    "data"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "config.release_activated"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "config-release.schema.json"
          },
          "scope": {
            "properties": {
              "kind": {
                "enum": [
                  "crew",
                  "ground",
                  "operator"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "environment.change_proposed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "environment-profile.schema.json"
          },
          "scope": {
            "properties": {
              "kind": {
                "enum": [
                  "crew",
                  "operator"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "environment.activated"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "environment-profile.schema.json"
          },
          "scope": {
            "properties": {
              "kind": {
                "enum": [
                  "crew",
                  "ground",
                  "operator"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "environment.change_rejected"
          }
