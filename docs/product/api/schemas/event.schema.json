              "kind": {
                "enum": [
                  "crew",
                  "operator"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "overlay.changed"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "activity-overlay.schema.json"
          },
          "scope": {
            "properties": {
              "kind": {
                "enum": [
