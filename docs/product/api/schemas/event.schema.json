          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "mission-event.schema.json"
          },
          "scope": {
            "properties": {
              "kind": {
                "enum": [
                  "crew",
                  "operator"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
