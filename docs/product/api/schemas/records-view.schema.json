{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "records-view.schema.json",
  "title": "RecordsView",
  "description": "The person's own records list, newest first.",
  "type": "object",
  "properties": {
    "person_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "observation",
              "daily_check",
              "episode",
              "report",
              "assessment",
              "handoff",
              "help_session",
              "warning",
              "plan_run",
              "guided_check"
            ]
          },
          "ref_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "$ref": "common.schema.json#/$defs/instant"
          },
          "origin_mode": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/origin_mode"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "ref_id",
          "title",
          "detail",
          "at",
          "origin_mode",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "person_id",
    "items",
    "next_cursor"
  ],
  "additionalProperties": false
}
