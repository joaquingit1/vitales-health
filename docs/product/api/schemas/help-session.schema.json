{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "help-session.schema.json",
  "title": "HelpSession",
  "description": "One Someone needs help session, run by the help module as a state machine over responder-flows.json pinned at open (CONTRACTS section 16). Nothing in it waits for the model, the network or the ground.",
  "type": "object",
  "properties": {
    "help_session_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "open",
        "closed"
      ]
    },
    "opened_at": {
      "$ref": "common.schema.json#/$defs/instant"
    },
    "client_opened_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/instant"
        },
        {
          "type": "null"
        }
      ]
    },
    "opened_by": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "entry": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "button",
            "red_flag",
            "warning",
            "urgent_event_alias",
            "plan_step"
          ],
          "description": "plan_step: opened by a plan run escalate action; ref_id is the plan run (CONTRACTS section 22)."
        },
        "ref_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "ref_id"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "self",
            "crewmate",
            "unknown"
          ]
        },
        "person_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "person_id",
        "display_name"
      ],
      "additionalProperties": false
    },
    "place": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "body_region": {
      "$ref": "common.schema.json#/$defs/body_region_or_null"
    },
    "helpers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "person_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "joined_at": {
            "$ref": "common.schema.json#/$defs/instant"
          }
        },
        "required": [
          "person_id",
          "display_name",
          "joined_at"
        ],
        "additionalProperties": false
      }
    },
    "config_pins": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/config_pin"
      },
      "minItems": 1
    },
    "level": {
      "enum": [
        "act",
        "emergency"
      ]
    },
    "level_basis": {
      "$ref": "common.schema.json#/$defs/basis"
    },
    "node": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "triage",
            "flow"
          ]
        },
        "id": {
          "$ref": "common.schema.json#/$defs/config_id"
        },
        "question": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "index",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "flow": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "plain": {
                  "type": "string",
                  "minLength": 1
                },
                "immediate_steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "ticked_at": {
                        "anyOf": [
                          {
                            "$ref": "common.schema.json#/$defs/instant"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "ticked_by": {
                        "anyOf": [
                          {
                            "$ref": "common.schema.json#/$defs/actor"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "index",
                      "text",
                      "ticked_at",
                      "ticked_by"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "questions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "measurements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "what": {
                        "type": "string",
                        "minLength": 1
                      },
                      "how": {
                        "type": "string",
                        "minLength": 1
                      },
                      "instrument": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "what",
                      "how",
                      "instrument"
                    ],
                    "additionalProperties": false
                  }
                },
                "treatment_steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "step": {
                        "type": "string",
                        "minLength": 1
                      },
                      "who": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kit": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "step",
                      "who",
                      "kit"
                    ],
                    "additionalProperties": false
                  }
                },
                "call_ground_when": {
                  "type": "string",
                  "minLength": 1
                },
                "environment_note": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "body_regions": {
                  "$ref": "common.schema.json#/$defs/body_regions"
                },
                "citation": {
                  "$ref": "common.schema.json#/$defs/citation"
                }
              },
              "required": [
                "title",
                "plain",
                "immediate_steps",
                "questions",
                "measurements",
                "treatment_steps",
                "call_ground_when",
                "environment_note",
                "body_regions",
                "citation"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "question",
        "answers",
        "flow"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "triage"
              }
            }
          },
          "then": {
            "properties": {
              "flow": {
                "type": "null"
              },
              "question": {
                "type": "string"
              },
              "answers": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "flow"
              }
            }
          },
          "then": {
            "properties": {
              "flow": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "path": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "$ref": "common.schema.json#/$defs/config_id"
          },
          "kind": {
            "enum": [
              "triage",
              "flow",
              "start_over"
            ]
          },
          "answer_index": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "answer_label": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "at": {
            "$ref": "common.schema.json#/$defs/instant"
          },
          "by": {
            "$ref": "common.schema.json#/$defs/actor"
          }
        },
        "required": [
          "node_id",
          "kind",
          "answer_index",
          "answer_label",
          "at",
          "by"
        ],
        "additionalProperties": false
      }
    },
    "log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "$ref": "common.schema.json#/$defs/instant"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "by": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/actor"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "answer",
              "step",
              "crew",
              "ground",
              "assistant",
              "note",
              "system"
            ]
          }
        },
        "required": [
          "at",
          "text",
          "by",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "crew_called_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/instant"
        },
        {
          "type": "null"
        }
      ]
    },
    "broadcast_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "assistant": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "off",
            "waiting",
            "answering",
            "stopped",
            "unavailable"
          ]
        },
        "conversation_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "conversation_id",
        "last_text"
      ],
      "additionalProperties": false
    },
    "ground_message_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "fixed_buttons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "call_crew",
              "tell_ground",
              "start_over"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 3
    },
    "closed_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/instant"
        },
        {
          "type": "null"
        }
      ]
    },
    "close": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "disposition": {
              "enum": [
                "resolved_on_board",
                "handed_to_crew_medical_officer",
                "ground_consulted",
                "false_alarm",
                "other"
              ]
            },
            "note": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "by": {
              "$ref": "common.schema.json#/$defs/actor"
            }
          },
          "required": [
            "disposition",
            "note",
            "by"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "allowed_actions": {
      "$ref": "common.schema.json#/$defs/allowed_actions"
    }
  },
  "required": [
    "help_session_id",
    "revision",
    "state",
    "opened_at",
    "client_opened_at",
    "opened_by",
    "entry",
    "subject",
    "place",
    "body_region",
    "helpers",
    "config_pins",
    "level",
    "level_basis",
    "node",
    "path",
    "log",
    "crew_called_at",
    "broadcast_id",
    "assistant",
    "ground_message_ids",
    "fixed_buttons",
    "closed_at",
    "close",
    "allowed_actions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "closed"
          }
        }
      },
      "then": {
        "properties": {
          "close": {
            "type": "object"
          },
          "closed_at": {
            "$ref": "common.schema.json#/$defs/instant"
          }
        }
      }
    }
  ]
}
