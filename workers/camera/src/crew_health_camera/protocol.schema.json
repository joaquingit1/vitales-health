      "title": "DescribeReply",
      "type": "object"
    },
    "ErrorReply": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "UNAUTHORIZED",
            "INVALID",
            "CONFLICT",
            "BUSY",
            "UNSUPPORTED",
            "NO_CAMERA",
            "NOT_PAIRED",
            "ORIGIN_MISMATCH",
            "NOT_FOUND"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "ErrorReply",
      "type": "object"
