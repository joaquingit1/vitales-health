    "StartRequest": {
      "additionalProperties": false,
      "properties": {
        "acquisition_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Acquisition Id",
          "type": "string"
