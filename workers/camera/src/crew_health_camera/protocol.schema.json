{
  "models": {
    "CancelReply": {
      "additionalProperties": false,
      "properties": {
        "acquisition_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Acquisition Id",
          "type": "string"
        },
        "result": {
          "enum": [
            "stopped",
            "cannot_stop",
            "unknown"
          ],
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "acquisition_id",
        "result"
      ],
      "title": "CancelReply",
      "type": "object"
    },
    "CancelRequest": {
      "additionalProperties": false,
      "description": "Optional body of a cancel. A persisted reference reading is released only when the hub names the observation\nit recorded the reading as.",
      "properties": {
        "recorded_observation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded Observation Id"
        }
      },
      "title": "CancelRequest",
      "type": "object"
    },
    "DescribeReply": {
      "$defs": {
        "CameraReply": {
          "additionalProperties": false,
          "properties": {
            "device_id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "title": "Device Id",
              "type": "string"
            },
            "kind": {
              "enum": [
                "personal",
                "station"
              ],
              "title": "Kind",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "subject_id": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Subject Id"
            }
          },
          "required": [
            "device_id",
            "name",
            "kind",
            "subject_id"
          ],
          "title": "CameraReply",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "cameras": {
          "items": {
            "$ref": "#/$defs/CameraReply"
          },
          "title": "Cameras",
          "type": "array"
        },
        "capability_codes": {
          "items": {
            "type": "string"
          },
          "title": "Capability Codes",
          "type": "array"
        },
        "max_ttl_ms": {
          "maximum": 3600000,
          "minimum": 1,
          "title": "Max Ttl Ms",
          "type": "integer"
        },
        "origin_mode": {
          "enum": [
            "LIVE",
            "REPLAY",
            "SIM"
          ],
          "title": "Origin Mode",
          "type": "string"
        },
        "policy": {
          "title": "Policy",
          "type": "string"
        },
        "protocol_version": {
          "const": "1",
          "title": "Protocol Version",
          "type": "string"
        },
        "ready_methods": {
          "items": {
            "type": "string"
          },
          "title": "Ready Methods",
          "type": "array"
        },
        "worker_utc": {
          "format": "date-time",
          "title": "Worker Utc",
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "adapter_id",
        "origin_mode",
        "policy",
        "cameras",
        "ready_methods",
        "capability_codes",
        "max_ttl_ms",
        "worker_utc"
