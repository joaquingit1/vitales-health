        "capability_code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Capability Code",
          "type": "string"
        },
        "clock_offset_ms": {
          "default": 0,
          "maximum": 86400000,
          "minimum": -86400000,
          "title": "Clock Offset Ms",
          "type": "integer"
        },
        "clock_uncertainty_ms": {
          "default": 0,
          "maximum": 86400000,
          "minimum": 0,
          "title": "Clock Uncertainty Ms",
          "type": "integer"
        },
        "device_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Device Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "measurement",
            "reference"
          ],
          "title": "Kind",
          "type": "string"
        },
        "patient_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Patient Id"
        },
        "persist": {
          "default": false,
          "title": "Persist",
          "type": "boolean"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "required_origin": {
          "anyOf": [
            {
              "enum": [
                "LIVE",
                "REPLAY",
                "SIM"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Origin"
        },
        "sequence": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "ttl_ms": {
          "maximum": 3600000,
          "minimum": 1,
          "title": "Ttl Ms",
          "type": "integer"
        },
        "warmup_max_ms": {
          "maximum": 60000,
          "minimum": 1000,
          "title": "Warmup Max Ms",
          "type": "integer"
        },
        "window_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window End"
        },
        "window_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Start"
        }
      },
      "required": [
        "acquisition_id",
        "kind",
        "capability_code",
        "ttl_ms",
        "warmup_max_ms"
      ],
      "title": "StartRequest",
      "type": "object"
    },
