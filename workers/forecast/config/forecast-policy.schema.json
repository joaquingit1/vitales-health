{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "basis",
    "model",
    "cadence",
    "min_context_days",
    "max_context_days",
    "horizon_days",
    "interval",
    "comparators",
    "max_series_points",
    "provenance"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "basis": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      }
    },
    "cadence": {
      "const": "mission_day"
    },
    "min_context_days": {
      "type": "integer",
      "minimum": 1
    },
    "max_context_days": {
      "type": "integer",
      "minimum": 1
    },
    "horizon_days": {
      "type": "integer",
      "minimum": 1
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "high"
      ],
      "properties": {
        "low": {
          "type": "string",
          "pattern": "^0\\.[0-9]+$"
        },
        "high": {
          "type": "string",
          "pattern": "^0\\.[0-9]+$"
        }
      }
    },
    "comparators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rolling_window_days"
      ],
      "properties": {
        "rolling_window_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "max_series_points": {
      "type": "integer",
      "minimum": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "min_context_days",
        "max_context_days",
        "horizon_days",
        "interval",
        "comparators",
        "max_series_points"
      ],
      "description": "Where each value comes from. NASA sources are checked first (nasa_checked); a value no source gives is a team default with the request that settles it.",
      "properties": {
        "model": {
          "$ref": "#/$defs/provenance_entry"
        },
        "min_context_days": {
          "$ref": "#/$defs/provenance_entry"
        },
        "max_context_days": {
          "$ref": "#/$defs/provenance_entry"
        },
        "horizon_days": {
          "$ref": "#/$defs/provenance_entry"
        },
        "interval": {
          "$ref": "#/$defs/provenance_entry"
        },
        "comparators": {
          "$ref": "#/$defs/provenance_entry"
        },
        "max_series_points": {
          "$ref": "#/$defs/provenance_entry"
        }
      }
    }
  },
  "$defs": {
    "provenance_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "nasa_checked",
        "package",
        "to_be_set_by"
      ],
      "properties": {
        "basis": {
          "enum": [
            "sourced",
            "team default"
          ]
        },
        "nasa_checked": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^NASA-SOURCES\\.md "
          }
        },
        "package": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "to_be_set_by": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
