        },
        {
          "step_id": "chp_record_pain",
          "text": "Note when it started and what they were doing, whether it is tight, crushing or squeezing, whether it spreads to the arms, neck, jaw or back, whether it changes when they breathe in or press on the chest, whether they are short of breath, sweating, sick or lightheaded, and whether it began during or after a spacewalk or hard exercise.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
          "substitute_only": false,
          "environments": null,
