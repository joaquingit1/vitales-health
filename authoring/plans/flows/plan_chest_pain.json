          "replaces_ground_task": null,
          "source_ids": [
            "S04",
            "C11"
          ],
          "basis": "sourced",
          "review_state": "unreviewed"
        },
        {
          "step_id": "chp_watch_signs",
          "text": "Keep watching how they look and feel: pain getting worse or spreading, breathlessness, sweating, sickness or fainting.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
