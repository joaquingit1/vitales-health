        }
      ]
    },
    {
      "stage_id": "watch",
      "steps": [
        {
          "step_id": "chp_recheck_readings",
          "text": "Repeat the pulse, blood pressure and oxygen readings and note each number with its time. Read the pulse at the camera station only if they are already sitting still there. Never move them there or delay care for it.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [
              "camera_station",
              "pulse_oximeter",
              "bp_cuff"
            ],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
          "substitute_only": false,
          "environments": null,
          "body_region": "heart",
          "landmark_id": null,
          "guided_check_skill_id": null,
          "cannot_replace_text": "It cannot replace an ECG.",
          "recheck": {
            "cadence": null,
