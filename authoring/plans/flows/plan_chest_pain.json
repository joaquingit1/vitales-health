          "review_state": "unreviewed"
        },
        {
          "step_id": "chp_cam_pulse",
          "text": "If they can already sit still at the camera station, read their pulse there. Never move them or delay a step for it. Movement gives No reading, which is kept as a failed reading. Never delay or stop rest or the spacewalk check for this.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [
              "camera_station"
            ],
            "supplies": [],
            "skills": []
          },
