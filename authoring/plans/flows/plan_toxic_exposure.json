          "review_state": "unreviewed"
        },
        {
          "step_id": "tox_temp",
          "text": "Take their temperature with the kit thermometer as its instructions say. Record the number and the time. Never delay or stop getting to clean air for this.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [
              "thermometer"
            ],
            "supplies": [],
