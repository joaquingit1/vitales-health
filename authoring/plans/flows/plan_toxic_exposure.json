          "review_state": "unreviewed"
        },
        {
          "step_id": "tox_note_exposure",
          "text": "Note what it was (smoke, ammonia, another chemical or not known), how long they were in it, and whether a mask was on.",
          "text_first_time": null,
          "who": "any_crew",
