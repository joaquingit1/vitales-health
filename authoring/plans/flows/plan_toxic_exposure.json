      "stage_id": "do_now",
      "steps": [
        {
          "step_id": "tox_masks",
          "text": "Protect yourself first: keep out of the affected air, and put your mask on before you help anyone if the kit lists masks or portable breathing apparatus. Then move the person to clean air, with a mask on them too if the kit lists one.",
          "text_first_time": null,
          "who": "any_crew",
