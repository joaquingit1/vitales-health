          "review_state": "unreviewed"
        },
        {
          "step_id": "tox_transit_cabin",
          "text": "On a single cabin vehicle there is no clean module to retreat to. Masks and suits are the protection.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
