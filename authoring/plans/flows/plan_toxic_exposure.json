          ],
          "basis": "sourced",
          "review_state": "unreviewed"
        },
        {
          "step_id": "tox_rinse",
          "text": "Chemical on the skin or in the eyes: rinse with plenty of water.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
