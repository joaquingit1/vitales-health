        },
        {
          "step_id": "prl_station",
          "text": "Gather in the safe haven. If the habitat has sensors, read cabin pressure and oxygen to work out the reserve time, and retreat to the safe haven before it runs out. If it has none, retreat to the safe haven now.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
