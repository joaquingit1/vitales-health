          "basis": "sourced",
          "review_state": "unreviewed"
        },
        {
          "step_id": "prl_watch_low_oxygen",
          "text": "Watch yourself and others for low oxygen signs: fast breathing, headache, lightheadedness, dizziness, tingling, sweating, clumsiness, poor judgement, tunnel vision, an odd good mood.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
