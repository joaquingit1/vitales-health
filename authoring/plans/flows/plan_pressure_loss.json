      "steps": [
        {
          "step_id": "prl_watch_after",
          "text": "Once safe, ask about headache, dizziness, tingling, blurred vision, joint pain, itchy or blotchy skin, ear or sinus pain, chest pain or trouble breathing.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
