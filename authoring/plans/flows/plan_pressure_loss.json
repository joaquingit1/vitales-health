          "review_state": "unreviewed"
        },
        {
          "step_id": "prl_transit",
          "text": "On a single cabin vehicle, put your suit on at once, if the kit lists suits.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
