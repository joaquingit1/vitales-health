        },
        {
          "step_id": "prl_cam_breath",
          "text": "If they are already still in front of the cameras, read their breathing rate there. Never delay a step for it. If it fails, count their breaths and enter the number. Never delay or stop the depressurization response for this.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [
              "camera_station"
            ],
