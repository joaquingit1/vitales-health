          "review_state": "unreviewed"
        },
        {
          "step_id": "dcs_bp",
          "text": "Put the cuff on the bare upper arm and follow the device instructions, arm supported and still. The level that needs action: to be set by clinical review. Never delay or stop reporting and returning to full pressure for this.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [
              "bp_cuff"
            ],
