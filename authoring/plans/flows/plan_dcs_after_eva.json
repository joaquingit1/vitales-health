          ],
          "basis": "sourced",
          "review_state": "unreviewed"
        },
        {
          "step_id": "dcs_treat_as",
          "text": "Treat joint or muscle pain, tingling or numbness, itchy or blotchy skin, weakness, confusion, vision change, breathing trouble or chest pain after a spacewalk as DCS until the medical officer says otherwise.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
