        },
        {
          "step_id": "dcs_full_pressure",
          "text": "Bring the person back to full cabin pressure, and give oxygen by mask if the kit lists one, as in the onboard procedure.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
