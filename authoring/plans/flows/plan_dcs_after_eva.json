          "review_state": "unreviewed"
        },
        {
          "step_id": "dcs_spo2",
          "text": "Clip the oximeter on a finger, hand warm, relaxed and still, until it shows one steady number. A normal number does not cancel serious symptoms. The level that needs action: to be set by clinical review. Never delay or stop reporting and returning to full pressure for this.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [
              "pulse_oximeter"
            ],
            "supplies": [],
            "skills": []
          },
