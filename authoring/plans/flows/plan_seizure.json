        },
        {
          "step_id": "szr_airway_after",
          "text": "When the jerking stops, open the airway and check breathing. If they breathe normally, put them in the recovery position where there is gravity. If they are not breathing normally, go back to the first screen and start chest compressions.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
