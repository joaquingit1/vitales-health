        },
        {
          "step_id": "brd_spacewalk",
          "text": "If this began after a spacewalk or a pressure loss, go back to the first screen of Someone needs help and choose Decompression sickness after a spacewalk.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
