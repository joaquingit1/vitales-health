        },
        {
          "step_id": "brd_swelling",
          "text": "If the lips, tongue or face swell, go back to the first screen of Someone needs help and choose Severe allergic reaction.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
