    {
      "stage_id": "watch",
      "steps": [
        {
          "step_id": "brd_watch_look",
          "text": "Keep watching their breathing, the colour of their lips and skin, and whether they can get words out.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
          "substitute_only": false,
