      "steps": [
        {
          "step_id": "brd_check_air",
          "text": "Check the air first. If there is an alarm, smoke or a smell, put on masks if the kit lists them, and go back to the first screen of Someone needs help and choose Toxic air, chemical exposure or smoke.",
          "text_first_time": null,
          "who": "any_crew",
