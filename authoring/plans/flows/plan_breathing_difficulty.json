        },
        {
          "step_id": "brd_record_history",
          "text": "Note whether it started suddenly or slowly, any chest pain, cough or coughing blood, any smoke, chemical smell or alarm, swelling of the lips, tongue or throat, a rash, a blow to the chest, and whether it began after a spacewalk or a pressure change.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
