          "review_state": "unreviewed"
        },
        {
          "step_id": "hdi_cam_pulse",
          "text": "If they can already sit still at the camera station, read their pulse there. Never move them or delay a step for it. Movement gives No reading, which is kept as a failed reading. Never delay or stop keeping the head and neck still for this.",
          "text_first_time": null,
          "who": "any_crew",
