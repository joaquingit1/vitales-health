          "review_state": "unreviewed"
        }
      ]
    },
    {
      "stage_id": "watch",
      "steps": [
        {
          "step_id": "hdi_alertness",
          "text": "Check how alert they are: awake and answering, answering only to voice, only to pain, or not at all. Record the answer and the time, and repeat it.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
