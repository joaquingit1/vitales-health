          "review_state": "unreviewed"
        },
        {
          "step_id": "hdi_pupils",
          "text": "Look at both pupils and note if one is larger than the other. Take a photo for the medical officer. Never delay or stop keeping the head and neck still for this.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [
              "camera_station"
            ],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
          "substitute_only": false,
