          "landmark_id": null,
          "guided_check_skill_id": null,
          "cannot_replace_text": null,
          "recheck": {
            "cadence": null,
            "n": null,
            "interval_seconds": null,
            "basis": "team default",
            "to_be_set_by": "clinical review"
          },
          "opens_help": false,
          "opens_flow_id": null,
          "medicine": null,
          "replaces_ground_task": null,
          "source_ids": [
            "RS25",
            "RS26"
          ],
          "basis": "sourced",
          "review_state": "unreviewed"
        },
        {
          "step_id": "hdi_stay",
          "text": "Stay with them. Do not leave them alone.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
