          "basis": "team default",
          "review_state": "unreviewed"
        },
        {
          "step_id": "hdi_bp",
          "text": "Put the cuff on the bare upper arm and follow the device instructions, arm supported and still. The level that needs action: to be set by clinical review. Never delay or stop keeping the head and neck still for this.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [
              "bp_cuff"
            ],
            "supplies": [],
            "skills": []
          },
