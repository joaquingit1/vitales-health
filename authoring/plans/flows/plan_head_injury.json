            "RS06"
          ],
          "basis": "sourced",
          "review_state": "unreviewed"
        },
        {
          "step_id": "hdi_still",
          "text": "Keep the head and neck still and in line if a neck injury is possible.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
          "substitute_only": false,
          "environments": null,
          "body_region": "neck",
          "landmark_id": null,
          "guided_check_skill_id": null,
          "cannot_replace_text": null,
          "recheck": null,
          "opens_help": false,
          "opens_flow_id": null,
          "medicine": null,
          "replaces_ground_task": null,
          "source_ids": [
            "RS26",
            "RS06"
          ],
          "basis": "sourced",
          "review_state": "unreviewed"
        },
        {
          "step_id": "hdi_cold",
          "text": "If they are awake, keep them still and hold something cold on the swelling. Press gently on any bleeding wound with a clean dressing if the kit lists one.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
          "substitute_only": false,
          "environments": null,
          "body_region": "head",
          "landmark_id": null,
          "guided_check_skill_id": null,
          "cannot_replace_text": null,
          "recheck": null,
          "opens_help": false,
          "opens_flow_id": null,
          "medicine": null,
          "replaces_ground_task": null,
          "source_ids": [
            "RS26"
          ],
          "basis": "sourced",
          "review_state": "unreviewed"
        },
        {
          "step_id": "hdi_alert_first",
          "text": "Check how alert they are: awake and answering, answering only to voice, only to pain, or not at all. Record the answer and the time.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
          "substitute_only": false,
          "environments": null,
          "body_region": "head",
          "landmark_id": null,
          "guided_check_skill_id": null,
          "cannot_replace_text": null,
          "recheck": null,
          "opens_help": false,
          "opens_flow_id": null,
          "medicine": null,
          "replaces_ground_task": null,
          "source_ids": [
            "RS25",
            "RS26"
          ],
          "basis": "sourced",
          "review_state": "unreviewed"
        },
        {
          "step_id": "hdi_ask",
          "text": "Ask: did you black out, do you remember what happened, do you have a headache and is it getting worse, are you sick, any double or blurred vision, any numbness or weakness.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
          "substitute_only": false,
          "environments": null,
          "body_region": "head",
          "landmark_id": null,
          "guided_check_skill_id": null,
          "cannot_replace_text": null,
          "recheck": null,
          "opens_help": false,
          "opens_flow_id": null,
          "medicine": null,
          "replaces_ground_task": null,
          "source_ids": [],
