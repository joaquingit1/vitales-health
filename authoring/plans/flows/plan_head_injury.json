      "steps": [
        {
          "step_id": "hdi_unresponsive",
          "text": "If they do not respond, assume a neck injury, keep the head and neck still and in line, and go back to the first screen.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
