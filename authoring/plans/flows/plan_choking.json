          "review_state": "unreviewed"
        }
      ]
    },
    {
      "stage_id": "watch",
      "steps": [
        {
          "step_id": "chk_watch_after",
          "text": "Once the object is out, keep watching their breathing. Ask whether the throat or chest hurts, or swallowing is hard.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
          "substitute_only": false,
          "environments": null,
          "body_region": null,
          "landmark_id": null,
          "guided_check_skill_id": null,
          "cannot_replace_text": null,
          "recheck": null,
          "opens_help": false,
          "opens_flow_id": null,
          "medicine": null,
          "replaces_ground_task": null,
          "source_ids": [],
          "basis": "team default",
          "review_state": "unreviewed"
        },
        {
          "step_id": "chk_spo2",
          "text": "Once the airway is clear: clip the oximeter on a finger, hand warm, relaxed and still, until it shows one steady number. A normal number does not cancel serious symptoms. The level that needs action: to be set by clinical review. Never delay or stop back blows and thrusts for this.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [
              "pulse_oximeter"
            ],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
          "substitute_only": false,
          "environments": null,
          "body_region": "lungs",
