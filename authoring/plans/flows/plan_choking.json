          "medicine": null,
          "replaces_ground_task": null,
          "source_ids": [],
          "basis": "team default",
          "review_state": "unreviewed"
        },
        {
          "step_id": "chk_cam_breath",
          "text": "Once the airway is clear, if they are already still in front of the cameras, read their breathing rate there. Never delay a step for it. If it fails, count their breaths and enter the number. Never delay or stop back blows and thrusts for this.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
