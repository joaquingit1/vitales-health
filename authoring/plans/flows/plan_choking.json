      "stage_id": "do_now",
      "steps": [
        {
          "step_id": "chk_cycles",
          "text": "If they can cough, tell them to keep coughing. Only if they cannot breathe, cough or make any noise, keep going with up to 5 sharp back blows and up to 5 abdominal thrusts, and check the mouth after each one, until the object comes out.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
          "substitute_only": false,
          "environments": null,
          "body_region": "neck",
          "landmark_id": null,
          "guided_check_skill_id": null,
          "cannot_replace_text": null,
          "recheck": null,
          "opens_help": false,
          "opens_flow_id": null,
          "medicine": null,
          "replaces_ground_task": null,
          "source_ids": [
            "RS09",
            "RS03",
            "RS10"
          ],
          "basis": "sourced",
          "review_state": "unreviewed"
        },
        {
          "step_id": "chk_brace",
          "text": "In weightlessness, brace against a wall or hold them with your legs. How to brace: to be set by clinical review.",
          "text_first_time": null,
          "who": "any_crew",
          "needs": {
            "instruments": [],
            "supplies": [],
            "skills": []
          },
          "substitute_step_id": null,
