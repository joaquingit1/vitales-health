      "roles": [
        {
          "role_id": "lead_helper",
          "skill_id": null,
          "task_text": "Give something sugary if they can swallow",
          "required": true
        },
        {
          "role_id": "medical_officer",
          "skill_id": null,
          "task_text": null,
          "required": true
        }
      ]
    },
    {
      "flow_id": "severe_abdominal_pain",
      "roles": [
        {
          "role_id": "lead_helper",
          "skill_id": null,
          "task_text": "Help them rest and stay with them",
          "required": true
        },
        {
          "role_id": "medical_officer",
          "skill_id": null,
          "task_text": null,
          "required": true
        }
      ]
