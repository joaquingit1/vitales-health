        {
          "role_id": "medical_officer",
          "skill_id": null,
          "task_text": null,
          "required": true
        }
      ]
    },
    {
      "flow_id": "head_injury",
      "roles": [
        {
          "role_id": "lead_helper",
          "skill_id": null,
          "task_text": "Keep the head and neck still and in line",
          "required": true
        },
        {
          "role_id": "medical_officer",
          "skill_id": null,
          "task_text": null,
          "required": true
        }
      ]
    },
    {
      "flow_id": "eye_injury",
      "roles": [
        {
          "role_id": "lead_helper",
          "skill_id": null,
          "task_text": "Rinse the eye",
          "required": true
        },
        {
          "role_id": "medical_officer",
          "skill_id": null,
          "task_text": null,
          "required": true
        }
      ]
    },
    {
      "flow_id": "burns",
      "roles": [
        {
          "role_id": "lead_helper",
          "skill_id": null,
          "task_text": "Cool the burn",
          "required": true
        },
        {
          "role_id": "medical_officer",
          "skill_id": null,
          "task_text": null,
          "required": true
