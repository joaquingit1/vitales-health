{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clinical import mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "provenance",
    "numeric",
    "interpretations"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "note"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "numeric": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system",
          "code",
          "indicator_code",
          "accepted_ucum"
        ],
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "indicator_code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "not": {
              "pattern": "[^a-z0-9_]"
            }
          },
          "accepted_ucum": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system",
          "code",
          "finding_kind"
        ],
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "finding_kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "not": {
              "pattern": "[^a-z0-9_]"
            }
          }
        }
      }
    }
  }
}
