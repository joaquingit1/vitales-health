{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter-health.schema.json",
  "title": "E07 adapter health and manifest",
  "description": "GET /health of an E07 adapter process: the generated health_schema.Adapter entry (adapter_id, state) plus the adapter manifest that PLAN P-E07-1 asks for. The manifest says which profile is active, which protocol it decodes, what evidence backs the decoder and the hardware, and which operation modes are available now. Hardware compatibility is 'unmeasured' until a tested kit device is recorded in the profile's evidence_ref; it is never inferred.",
  "type": "object",
  "properties": {
    "adapter_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["connected", "quiet", "disconnected"]},
    "manifest": {"$ref": "#/$defs/manifest"}
  },
  "required": ["adapter_id", "state", "manifest"],
  "additionalProperties": false,
  "$defs": {
    "manifest": {
      "type": "object",
      "properties": {
        "family": {"enum": ["oximeter", "cuff", "thermometer"]},
        "profile": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "device_label": {"type": "string", "minLength": 1},
            "model": {"type": ["string", "null"]},
            "calibration": {"type": "string", "minLength": 1}
          },
          "required": ["id", "version", "device_label", "model", "calibration"],
          "additionalProperties": false
        },
        "protocol": {
          "type": "object",
          "properties": {
            "service": {"type": "string", "pattern": "^0x[0-9A-F]{4}$"},
            "characteristics": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "pattern": "^0x[0-9A-F]{4}$"}
            }
          },
          "required": ["service", "characteristics"],
          "additionalProperties": false
        },
        "decoder_evidence": {"const": "specification_golden_cases"},
        "hardware_compatibility": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": ["string", "null"]},
        "operations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {"enum": ["connected", "recorded"]},
                  "origin": {"enum": ["LIVE", "REPLAY", "SIM"]},
                  "status": {"enum": ["available", "unavailable"]},
                  "reason": {
                    "enum": ["connected", "source_not_connected", "recording_selected", "recording_not_selected"]
                  }
                },
                "required": ["mode", "origin", "status", "reason"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {"const": "manual"},
                  "origin": {"const": "LIVE"},
                  "status": {"const": "hub_owned"}
                },
                "required": ["mode", "origin", "status"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "family",
        "profile",
        "protocol",
        "decoder_evidence",
        "hardware_compatibility",
        "evidence_ref",
        "operations"
      ],
      "additionalProperties": false
    }
  }
}
