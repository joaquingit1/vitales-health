{
  "type": "object",
  "properties": {
    "origin": {
      "enum": [
        "REPLAY",
        "SIM"
      ]
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "frames": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "characteristic": {
                "type": "string",
                "minLength": 1
              },
              "payload_hex": {
                "type": "string",
                "maxLength": 1024,
                "pattern": "^(?:[0-9a-fA-F]{2})*$"
              }
            },
            "required": [
              "characteristic",
              "payload_hex"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "event": {
                "enum": [
                  "disconnect",
                  "timeout",
                  "device_absent",
                  "radio_absent"
                ]
              }
            },
            "required": [
              "event"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "origin",
    "provenance",
    "frames"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
