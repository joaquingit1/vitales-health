{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feeds.schema.json",
  "title": "HabitatFeeds",
  "description": "Habitat feed definitions (E23 5.2). A feed names where readings come from and how they are labeled. Every choice carries a basis. Demo feeds load only when the deployment profile is demo.",
  "type": "object",
  "properties": {
    "profile": {"const": "demo"},
    "feeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/feed"}
    }
  },
  "required": ["profile", "feeds"],
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "basis": {
      "type": "object",
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
      },
      "required": ["text", "source_ids"],
      "additionalProperties": false
    },
    "pace": {
      "oneOf": [
        {
          "type": "object",
          "properties": {"mode": {"const": "burst"}},
          "required": ["mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {"const": "fixed"},
            "interval_s": {"type": "number", "exclusiveMinimum": 0}
          },
          "required": ["mode", "interval_s"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {"const": "recorded"},
            "speedup": {"type": "number", "exclusiveMinimum": 0}
          },
          "required": ["mode", "speedup"],
          "additionalProperties": false
        }
      ]
    },
    "criteria": {
      "type": "object",
      "description": "Sourced plausibility criteria in the wire unit. Each present criterion needs its source in basis. A feed with none captures readings as not_assessed.",
      "properties": {
        "min": {"type": "number"},
        "max": {"type": "number"},
        "saturation": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "stuck": {
          "type": "object",
          "properties": {
            "count": {"type": "integer", "minimum": 2},
            "span_s": {"type": "number", "exclusiveMinimum": 0}
          },
          "required": ["count", "span_s"],
          "additionalProperties": false
        },
        "max_rate_per_s": {"type": "number", "exclusiveMinimum": 0},
        "basis": {"$ref": "#/$defs/basis"}
      },
      "required": ["basis"],
      "additionalProperties": false
    },
    "sim": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {"const": "frozen"},
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "items": {
                "type": "object",
                "properties": {
                  "offset_s": {"type": "number", "minimum": 0},
                  "value": {"type": "number"}
                },
                "required": ["offset_s", "value"],
                "additionalProperties": false
              }
            }
          },
          "required": ["type", "rows"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "generator"},
            "seed": {"type": "integer"},
            "start": {"type": "number"},
            "step_sd": {"type": "number", "minimum": 0},
            "interval_s": {"type": "number", "exclusiveMinimum": 0},
            "count": {"type": "integer", "minimum": 1, "maximum": 100000}
          },
          "required": ["type", "seed", "start", "step_sd", "interval_s", "count"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "twin"},
            "protocol": {"enum": ["ble_ess", "xtce"]},
            "scenario": {"type": "string", "minLength": 1},
            "select": {"type": "string", "minLength": 1},
            "seed": {"type": "integer"},
            "data_dir": {"type": "string", "minLength": 1}
          },
          "required": ["type", "protocol", "scenario", "select", "seed", "data_dir"],
          "additionalProperties": false
        }
      ]
    },
    "feed": {
      "type": "object",
      "properties": {
        "feed_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["replay", "sim"]},
        "adapter_id": {"$ref": "#/$defs/id"},
        "channel_id": {"$ref": "#/$defs/id"},
        "file": {"type": "string", "minLength": 1},
        "columns": {
          "type": "object",
          "properties": {
            "time": {"type": "string", "minLength": 1},
            "value": {"type": "string", "minLength": 1},
            "unit": {"type": "string", "minLength": 1}
          },
          "required": ["time", "value", "unit"],
          "additionalProperties": false
        },
        "row_filter": {
          "type": "object",
          "properties": {
            "column": {"type": "string", "minLength": 1},
            "equals": {"type": "string", "minLength": 1}
          },
          "required": ["column", "equals"],
          "additionalProperties": false
        },
        "dataset": {"type": "string", "minLength": 1},
        "time_basis": {"type": "string", "minLength": 1},
        "naive_time": {"const": "carry_as_dataset_clock"},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "pace": {"$ref": "#/$defs/pace"},
        "cabin_pressure": {
          "type": "object",
          "properties": {
            "value": {"type": "number", "exclusiveMinimum": 0},
            "basis": {"enum": ["measured", "assumed"]},
            "source": {"$ref": "#/$defs/basis"}
          },
          "required": ["value", "basis", "source"],
          "additionalProperties": false
        },
        "criteria": {"$ref": "#/$defs/criteria"},
        "sim": {"$ref": "#/$defs/sim"},
        "unit": {"type": "string", "minLength": 1},
        "basis": {
          "type": "object",
          "description": "The basis of each choice: pace, time_basis, columns, unit and every other declared choice.",
          "additionalProperties": {"$ref": "#/$defs/basis"},
          "minProperties": 1
        }
      },
      "required": ["feed_id", "kind", "adapter_id", "channel_id", "basis"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "replay"}}},
          "then": {
            "required": ["file", "columns", "dataset", "time_basis", "pace"],
            "not": {"required": ["sim"]}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "sim"}}},
          "then": {"required": ["sim", "unit", "pace"], "not": {"required": ["file", "dataset"]}}
        }
      ]
    }
  }
}
