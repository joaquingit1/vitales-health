{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config-episode-rules.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "boolean"
    },
    "notice": {
      "type": "string",
      "minLength": 1
    },
    "task_policies": {
      "type": "object",
      "properties": {
        "review": {
          "type": "string",
          "minLength": 1
        },
        "review_item": {
          "type": "string",
          "minLength": 1
        },
        "custom": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "review",
        "review_item",
        "custom"
      ],
      "additionalProperties": false
    },
    "due_policies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "policy_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "none",
              "after",
              "end_of_mission_day",
              "chosen_by_person"
            ]
          },
          "duration": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "enum": [
                  "s",
                  "min",
                  "h",
                  "d"
                ]
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "additionalProperties": false
          },
          "min": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "enum": [
                  "s",
                  "min",
                  "h",
                  "d"
                ]
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "additionalProperties": false
          },
          "max": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "enum": [
                  "s",
                  "min",
                  "h",
                  "d"
                ]
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "additionalProperties": false
          },
          "status": {
            "enum": [
              "set",
              "threshold_pending"
            ]
          },
          "to_be_set_by": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "policy_id",
          "kind",
          "basis",
          "source_ids"
        ],
        "additionalProperties": false
      }
    },
    "task_templates": {
      "type": "object",
      "properties": {
        "review_assessment": {
          "type": "string",
          "minLength": 1
        },
        "review_correction": {
          "type": "string",
          "minLength": 1
        },
        "review_requested": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "review_assessment",
        "review_correction",
        "review_requested"
      ],
      "additionalProperties": false
    },
    "late_entry_after": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "s",
            "min",
            "h",
            "d"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "unit",
        "basis"
      ],
      "additionalProperties": false
    },
    "review_state": {
      "enum": [
        "unreviewed",
        "reviewed"
      ]
    },
    "written_by": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "checked_by": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "example",
    "notice",
    "task_policies",
    "due_policies",
    "task_templates",
    "late_entry_after",
    "review_state",
    "written_by",
    "checked_by"
  ],
  "additionalProperties": false
}
