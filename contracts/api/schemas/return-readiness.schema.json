{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "return-readiness.schema.json",
  "title": "ReturnReadiness",
  "description": "Stay or return for one person (CONTRACTS section 27), computed from the person's plan run whose plan has a return stage for the active environment. Only where that environment's return_option is not null; elsewhere CONTEXT_INAPPLICABLE. It lists; it never decides: there is no decision field.",
  "type": "object",
  "properties": {
    "subject": {
      "$ref": "common.schema.json#/$defs/person_ref"
    },
    "environment_id": {
      "$ref": "common.schema.json#/$defs/environment_id"
    },
    "plan_run_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_id": {
      "anyOf": [
        {
          "type": "string",
          "description": "An onboard-plans.json plan ID.",
          "pattern": "^plan_[a-z0-9_]{1,59}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "closed",
        "open",
        "preparing",
        "stood_down"
      ],
      "description": "closed: no plan run with a return stage is active. open: one is, and its criteria are listed. preparing: a prepare step is done. stood_down: the run closed with a disposition other than preparing_return after preparing started."
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "met",
              "not_met",
              "unknown"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "source_ids": {
            "$ref": "common.schema.json#/$defs/source_ids"
          },
          "to_be_set_by": {
            "$ref": "common.schema.json#/$defs/to_be_set_by"
          }
        },
        "required": [
          "text",
          "status",
          "evidence_ids",
          "source_ids",
          "to_be_set_by"
        ],
        "additionalProperties": false
      }
    },
    "criteria_text": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "prepare": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "$ref": "common.schema.json#/$defs/config_id"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "open",
              "done"
            ]
          },
          "by": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/actor"
              },
              {
                "type": "null"
              }
            ]
          },
          "at": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/instant"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "step_id",
          "text",
          "state",
          "by",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "decided_by": {
      "type": "array",
      "items": {
        "enum": [
          "commander",
          "crew_medical_officer"
        ]
      },
      "uniqueItems": true
    },
    "who_decides_text": {
      "type": "string",
      "minLength": 1
    },
    "trip_text": {
      "type": "string",
      "minLength": 1
    },
    "trip_source_ids": {
      "$ref": "common.schema.json#/$defs/source_ids"
    },
    "rtdc": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/rtdc"
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of": {
      "$ref": "common.schema.json#/$defs/instant"
    }
  },
  "required": [
    "subject",
    "environment_id",
    "plan_run_id",
    "plan_id",
    "state",
    "criteria",
    "criteria_text",
    "prepare",
    "decided_by",
    "who_decides_text",
    "trip_text",
    "trip_source_ids",
    "rtdc",
    "as_of"
  ],
  "additionalProperties": false
}
