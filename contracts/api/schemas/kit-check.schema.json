{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kit-check.schema.json",
  "title": "KitCheck",
  "description": "The AI gate result (CONTRACTS section 21). Computed when the request is proposed; never recomputed later.",
  "type": "object",
  "properties": {
    "can": {
      "type": "boolean"
    },
    "instrument_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/config_id"
      },
      "description": "Instruments aboard that provide the capability.",
      "uniqueItems": true
    },
    "missing_instrument_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/config_id"
      },
      "description": "Instruments that would provide it but are not aboard. Empty when can is true.",
      "uniqueItems": true
    },
    "condition_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ICL[1-9][0-9]{0,2}$"
      },
      "uniqueItems": true
    },
    "cliff_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "text": {
      "type": "string",
      "description": "Rendered from ui-copy, for example This kit can: camera station, or This kit can't: needs an ECG.",
      "minLength": 1
    },
    "kit_map_version": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "environment_id": {
      "$ref": "common.schema.json#/$defs/environment_id"
    }
  },
  "required": [
    "can",
    "instrument_ids",
    "missing_instrument_ids",
    "condition_ids",
    "cliff_urls",
    "text",
    "kit_map_version",
    "environment_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "can": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "instrument_ids": {
            "minItems": 1
          },
          "missing_instrument_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "can": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "instrument_ids": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
