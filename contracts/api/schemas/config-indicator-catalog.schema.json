{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config-indicator-catalog.schema.json",
  "title": "indicator-catalog.json",
  "description": "Display and baseline rules for personal indicators (sleep, mood, reaction time, vital signs). Codes are input-dictionary.json field IDs. Edited by the team.",
  "type": "object",
  "properties": {
    "notice": {
      "type": "string",
      "description": "Shown on every page that renders this document's clinical content, for example: Unreviewed draft: needs clinician review before live guidance.",
      "minLength": 1
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "common.schema.json#/$defs/config_id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "unit_display": {
            "type": "string"
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "body_region": {
            "$ref": "common.schema.json#/$defs/body_region_or_null"
          },
          "trend_days": {
            "type": "integer",
            "minimum": 1
          },
          "baseline": {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "median",
                  "mean"
                ]
              },
              "window_days": {
                "type": "integer",
                "minimum": 1
              },
              "min_samples": {
                "type": "integer",
                "minimum": 1
              },
              "basis": {
                "$ref": "common.schema.json#/$defs/basis"
              },
              "within_usual": {
                "type": "object",
                "description": "How far today's value may sit from the usual value and still read as within usual. A value further away reads as above or below usual. Both values are compared at the indicator's display precision (decimals).",
                "properties": {
                  "band": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,5})(\\.[0-9]{1,3})?$",
                    "description": "Largest absolute difference from the usual value, in the indicator's unit, that still reads as within usual. Decimal text with at most decimals places; 0 means equal at display precision. The release check rejects a finer band."
                  },
                  "basis": {
                    "$ref": "common.schema.json#/$defs/basis"
                  },
                  "source_ids": {
                    "$ref": "common.schema.json#/$defs/source_ids",
                    "description": "Sources that give this band. Required when basis is sourced; empty while the band is a team default."
                  },
                  "nasa_checked": {
                    "$ref": "common.schema.json#/$defs/source_ids",
                    "description": "NASA catalog IDs (NASA-SOURCES.md) read before the band was set, kept when none of them gives a band."
                  },
                  "to_be_set_by": {
                    "$ref": "common.schema.json#/$defs/to_be_set_by"
                  }
                },
                "required": [
                  "band",
                  "basis",
                  "source_ids",
                  "nasa_checked",
                  "to_be_set_by"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "method",
              "window_days",
              "min_samples",
              "basis",
              "within_usual"
            ],
            "additionalProperties": false
          },
          "better": {
            "enum": [
              "higher",
              "lower",
              "neither"
            ]
          },
          "basis": {
            "$ref": "common.schema.json#/$defs/basis"
          }
        },
        "required": [
          "code",
          "label",
          "unit_display",
          "decimals",
          "body_region",
          "trend_days",
          "baseline",
          "better",
          "basis"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "reaction_test": {
      "type": "object",
      "properties": {
        "lapse_ms": {
          "type": "integer",
          "minimum": 1
        },
        "basis": {
          "$ref": "common.schema.json#/$defs/basis"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "lapse_ms",
        "basis",
        "note"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "notice",
    "indicators",
    "reaction_test"
  ],
  "additionalProperties": false
}
