                                "type": "array",
                                "items": {
                                  "$ref": "common.schema.json#/$defs/config_id"
                                },
                                "description": "kit-map instrument IDs the step needs, all of them.",
                                "uniqueItems": true
                              },
                              "supplies": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "supply_id": {
                                      "$ref": "common.schema.json#/$defs/config_id"
                                    },
                                    "per_use": {
                                      "anyOf": [
                                        {
                                          "type": "number",
                                          "exclusiveMinimum": 0,
                                          "description": "Units of the supply one run of this step uses, in the supply's unit. null: not set, so cover cannot be computed."
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "basis": {
                                      "$ref": "common.schema.json#/$defs/basis"
                                    },
                                    "to_be_set_by": {
                                      "$ref": "common.schema.json#/$defs/to_be_set_by"
                                    }
                                  },
                                  "required": [
                                    "supply_id",
                                    "per_use",
                                    "basis",
                                    "to_be_set_by"
                                  ],
                                  "additionalProperties": false
                                },
                                "description": "kit-map supplies the step uses.",
                                "uniqueItems": true
                              },
                              "skills": {
                                "type": "array",
                                "items": {
                                  "$ref": "common.schema.json#/$defs/config_id"
                                },
                                "description": "skills-catalog skill IDs someone on board must hold for the step.",
                                "uniqueItems": true
                              }
                            },
                            "required": [
                              "instruments",
                              "supplies",
                              "skills"
                            ],
                            "additionalProperties": false,
                            "description": "What the step needs. The hub computes availability from the active kit, stock and roster (CONTRACTS section 22)."
                          },
                          "substitute_step_id": {
                            "anyOf": [
                              {
                                "$ref": "common.schema.json#/$defs/config_id"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "substitute_only": {
                            "type": "boolean",
                            "description": "True for a step shown only in place of a step that names it as substitute_step_id when that step is not aboard."
                          },
                          "environments": {
                            "anyOf": [
                              {
                                "type": "array",
                                "items": {
                                  "$ref": "common.schema.json#/$defs/environment_id"
                                },
                                "description": "Only in these environments; null means every environment of the plan.",
                                "minItems": 1,
                                "uniqueItems": true
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "body_region": {
                            "$ref": "common.schema.json#/$defs/body_region_or_null"
                          },
                          "landmark_id": {
                            "anyOf": [
                              {
                                "$ref": "common.schema.json#/$defs/config_id"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "guided_check_skill_id": {
                            "anyOf": [
                              {
                                "$ref": "common.schema.json#/$defs/config_id"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "cannot_replace_text": {
                            "anyOf": [
                              {
                                "type": "string",
                                "description": "What this check cannot replace, shown beside it, for example: It cannot replace an ECG.",
                                "minLength": 1
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "recheck": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "cadence": {
                                    "anyOf": [
                                      {
                                        "$ref": "common.schema.json#/$defs/cadence_word"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "n": {
                                    "anyOf": [
                                      {
                                        "type": "integer",
                                        "minimum": 1
                                      },
                                      {
                                        "type": "null"
                                      }
