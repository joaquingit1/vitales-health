{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kit-map-what-if.schema.json",
  "title": "KitMapWhatIf",
  "description": "The result of POST /v1/kit-map/what-if: the same computation with extra instruments added to the kit. Nothing is stored and no event is sent.",
  "type": "object",
  "properties": {
    "environment_id": {
      "$ref": "common.schema.json#/$defs/environment_id"
    },
    "kit_map_version": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "added_instrument_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/config_id"
      },
      "uniqueItems": true
    },
    "ignored_instrument_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/config_id"
      },
      "description": "Requested instruments already aboard.",
      "uniqueItems": true
    },
    "base_counts": {
      "type": "object",
      "properties": {
        "measured_here": {
          "type": "integer",
          "minimum": 0
        },
        "report_only": {
          "type": "integer",
          "minimum": 0
        },
        "needs_test_not_aboard": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "measured_here",
        "report_only",
        "needs_test_not_aboard",
        "total"
      ],
      "additionalProperties": false
    },
    "what_if_counts": {
      "type": "object",
      "properties": {
        "measured_here": {
          "type": "integer",
          "minimum": 0
        },
        "report_only": {
          "type": "integer",
          "minimum": 0
        },
        "needs_test_not_aboard": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "measured_here",
        "report_only",
        "needs_test_not_aboard",
        "total"
      ],
      "additionalProperties": false
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/body_region"
              },
              {
                "const": "whole_body"
              }
            ]
          },
          "counts": {
            "type": "object",
            "properties": {
              "measured_here": {
                "type": "integer",
                "minimum": 0
              },
              "report_only": {
                "type": "integer",
                "minimum": 0
              },
              "needs_test_not_aboard": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "measured_here",
              "report_only",
              "needs_test_not_aboard",
              "total"
            ],
            "additionalProperties": false
          },
          "marks": {
            "type": "array",
            "items": {
              "enum": [
                "measured_here",
                "report_only",
                "needs_test_not_aboard"
              ]
            },
            "description": "States present in this region, in the fixed order measured_here, report_only, needs_test_not_aboard. The client draws one glyph per entry.",
            "uniqueItems": true
          }
        },
        "required": [
          "region",
          "counts",
          "marks"
        ],
        "additionalProperties": false
      }
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition_id": {
            "type": "string",
            "pattern": "^ICL[1-9][0-9]{0,2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "enum": [
              "measured_here",
              "report_only",
              "needs_test_not_aboard"
            ]
          },
          "to": {
            "enum": [
              "measured_here",
              "report_only",
              "needs_test_not_aboard"
            ]
          },
          "body_regions": {
            "$ref": "common.schema.json#/$defs/body_regions"
          },
          "cliff_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "condition_id",
          "name",
          "from",
          "to",
          "body_regions",
          "cliff_url"
        ],
        "additionalProperties": false
      }
    },
    "added_supplies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "supply_id": {
            "$ref": "common.schema.json#/$defs/config_id"
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "supply_id",
          "quantity"
        ],
        "additionalProperties": false
      }
    },
    "added_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_id": {
            "$ref": "common.schema.json#/$defs/config_id"
          },
          "person_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "skill_id",
          "person_ids"
        ],
        "additionalProperties": false
      },
      "description": "Crewmates who would practice the skill; treated as fresh holders for the computation."
    },
    "plans_changed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "plan_id": {
            "type": "string",
            "pattern": "^plan_[a-z0-9_]{1,59}$"
          },
          "condition_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^ICL[1-9][0-9]{0,2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "flow_id": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/config_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "from": {
            "type": "object",
            "properties": {
              "plan_aboard": {
                "type": "boolean"
              },
              "waits_for_medical_officer": {
                "type": "boolean"
              }
            },
            "required": [
              "plan_aboard",
              "waits_for_medical_officer"
            ],
            "additionalProperties": false
          },
          "to": {
            "type": "object",
            "properties": {
              "plan_aboard": {
                "type": "boolean"
              },
              "waits_for_medical_officer": {
                "type": "boolean"
              }
            },
            "required": [
              "plan_aboard",
              "waits_for_medical_officer"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "plan_id",
          "condition_id",
          "flow_id",
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "description": "Plans whose plan_aboard or waits_for_medical_officer changes in this environment."
    },
    "cover_changed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "supply_id": {
            "$ref": "common.schema.json#/$defs/config_id"
          },
          "from_uses": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "to_uses": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "supply_id",
          "from_uses",
          "to_uses"
        ],
        "additionalProperties": false
      }
    },
    "persisted": {
      "const": false
    }
  },
  "required": [
    "environment_id",
    "kit_map_version",
    "added_instrument_ids",
    "ignored_instrument_ids",
    "base_counts",
    "what_if_counts",
    "regions",
    "changed",
    "added_supplies",
    "added_skills",
    "plans_changed",
    "cover_changed",
    "persisted"
  ],
  "additionalProperties": false
}
