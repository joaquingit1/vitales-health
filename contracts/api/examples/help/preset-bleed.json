      "flow": {
        "title": "Severe bleeding",
        "plain": "Blood is pouring or pumping out, or the bleeding will not slow. Press hard on it and keep pressing.",
        "immediate_steps": [
          {
            "index": 0,
            "text": "Put on gloves if they are at hand. Do not wait for them.",
            "ticked_at": null,
            "ticked_by": null
          },
          {
            "index": 1,
            "text": "Press hard on the wound with a dressing or a clean cloth. Keep pressing.",
            "ticked_at": null,
            "ticked_by": null
          },
          {
            "index": 2,
            "text": "If something is stuck in the wound, do not pull it out. Press around it.",
            "ticked_at": null,
            "ticked_by": null
          },
          {
            "index": 3,
            "text": "If blood is pumping out, or pressing does not slow it, put a tourniquet from the kit on the arm or leg: 5 to 7 cm above the wound, never over a joint. Tighten until the bleeding stops. Do not loosen it. Write down the time.",
            "ticked_at": null,
            "ticked_by": null
          },
          {
            "index": 4,
            "text": "If blood soaks through, take the dressing off and press again with a new one.",
            "ticked_at": null,
            "ticked_by": null
          },
          {
            "index": 5,
            "text": "In weightlessness, blood floats away as drops. Catch it with gauze or suction.",
            "ticked_at": null,
            "ticked_by": null
          },
          {
            "index": 6,
            "text": "Call the CMO. Keep pressing until the CMO takes over.",
            "ticked_at": null,
            "ticked_by": null
          }
        ],
        "questions": [
          "Where is the bleeding? Tap the place on the body map.",
          "What caused it: a sharp edge, a crush, a fall?",
          "Any other injury?",
          "Do they feel faint, cold or thirsty?"
        ],
        "measurements": [
          {
            "what": "Blood pressure",
            "how": "Put the cuff on an arm that is not injured, as the device instructions say. The level that needs action: threshold to be set by clinical review.",
            "instrument": "BP cuff"
          },
          {
            "what": "Oxygen level (SpO2) and pulse",
            "how": "Clip it on a finger. Keep the hand warm, relaxed and still. Wait until it shows one steady number. Read it together with the symptoms: a normal number does not cancel serious symptoms. The level that needs action: threshold to be set by clinical review.",
            "instrument": "pulse oximeter"
          },
          {
            "what": "Pulse from the cameras",
            "how": "Only if the person can already sit still at the camera station. Never move them there or delay a step for it. Movement gives No reading, which is kept as a failed reading.",
            "instrument": "camera station"
          },
          {
            "what": "Temperature",
            "how": "Use the kit thermometer as its instructions say. Record the number and the time.",
            "instrument": "thermometer"
          }
        ],
        "treatment_steps": [
          {
            "step": "Direct pressure with a dressing or a clean cloth",
            "who": "any crew",
            "kit": "dressings, gloves"
          },
          {
            "step": "Tourniquet for limb bleeding that pressure cannot control",
            "who": "any crew",
            "kit": "tourniquet, if listed"
          },
          {
            "step": "Haemostatic dressing (a dressing that helps blood clot), as in the onboard procedure",
            "who": "crew medical officer",
            "kit": "haemostatic dressing, if listed"
          },
          {
            "step": "Suction or rinsing to clear floating blood from the wound",
            "who": "crew medical officer",
            "kit": "suction, if listed"
          },
          {
            "step": "Fluids into a vein and other treatment for shock, as in the onboard procedure",
            "who": "crew medical officer",
            "kit": "as in the onboard procedure"
          },
          {
            "step": "Log for the ground: the injury and what was done. Voice and video support joins only while the link is up. It leaves at the next contact; nothing waits for it.",
            "who": "ground",
            "kit": "message link; voice and video while the link is up"
          }
        ],
        "call_ground_when": "Log for the ground at once, and keep voice and video open while the link is up. It leaves at the next contact; nothing here waits for it.",
        "environment_note": "Floating blood: catch drops with gauze or suction. The ground link is usually available.",
