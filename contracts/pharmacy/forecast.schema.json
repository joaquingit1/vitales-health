{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crew-health-check.invalid/schemas/pharmacy/forecast.schema.json",
  "title": "Engine output: out-of-specification forecast for one ingredient of one lot.",
  "type": "object",
  "additionalProperties": false,
  "description": "When the ``quantile_probability`` quantile of potency crosses the lower limit under the declared projection of future conditions (spec 11.4).",
  "required": [
    "forecast_id",
    "lot_id",
    "ingredient_id",
    "as_of_utc",
    "as_of_s",
    "quantile_probability",
    "lower_limit_percent",
    "projection",
    "status",
    "crossing_utc",
    "crossing_s",
    "horizon_s",
    "crossing_delay_quantiles_s",
    "pins"
  ],
  "properties": {
    "forecast_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "lot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "ingredient_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "as_of_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "as_of_s": {
      "type": "number",
      "minimum": 0
    },
    "quantile_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "lower_limit_percent": {
      "type": "number"
    },
    "projection": {
      "$ref": "#/$defs/Projection"
    },
    "status": {
      "enum": [
        "already_crossed",
        "within_horizon",
        "beyond_horizon"
      ]
    },
    "crossing_utc": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "crossing_s": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "horizon_s": {
      "type": "number",
      "minimum": 0
    },
    "crossing_delay_quantiles_s": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/QuantileValue"
      }
    },
    "pins": {
      "$ref": "#/$defs/Pins"
    }
  },
  "$defs": {
    "ConfigPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "version",
        "sha256"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Pins": {
      "type": "object",
      "additionalProperties": false,
      "description": "Everything needed to reproduce an output bit for bit (decision 12).",
      "required": [
        "engine_version",
        "config",
        "sensor_series",
        "observations_sha256",
        "seed_hex",
        "rng",
        "numpy_version",
        "rdkit_version",
        "tblite_version",
        "computed_cache_keys"
      ],
      "properties": {
        "engine_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "config": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConfigPin"
          }
        },
        "sensor_series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeriesPin"
          }
        },
        "observations_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "rng": {
          "enum": [
            "numpy.PCG64"
          ]
        },
        "numpy_version": {
          "type": "string"
        },
        "rdkit_version": {
          "type": "string"
        },
        "tblite_version": {
          "type": "string"
        },
        "computed_cache_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "window_s",
        "zone_id",
        "package_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "repeat_last_window",
            "declared_constant"
          ]
        },
        "window_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "zone_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "package_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      }
    },
    "QuantileValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probability",
        "value"
      ],
      "properties": {
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "value": {
          "type": "number"
        }
      }
    },
    "SeriesPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_id",
        "sha256"
      ],
      "properties": {
        "series_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
