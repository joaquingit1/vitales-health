{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crew-health-check.invalid/schemas/pharmacy/scenario.schema.json",
  "title": "Scenario fixture: mission, zones, scripted events, observations and expectations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "schema",
    "version",
    "review_state",
    "notice",
    "mission",
    "zones",
    "events",
    "lot_ids",
    "assays",
    "inspections",
    "assessment_times_utc",
    "expectations"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "schema": {
      "const": "pharmacy/scenario.schema.json"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "review_state": {
      "enum": [
        "draft",
        "reviewed",
        "approved"
      ]
    },
    "notice": {
      "type": "string"
    },
    "mission": {
      "$ref": "#/$defs/ScenarioMission"
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScenarioZone"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScenarioEvent"
      }
    },
    "lot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "assays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AssayRecord"
      }
    },
    "inspections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InspectionRecord"
      }
    },
    "assessment_times_utc": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
      }
    },
    "expectations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Expectation"
      }
    }
  },
  "$defs": {
    "AssayRecord": {
      "type": "object",
      "additionalProperties": false,
      "description": "JSON form of ``AssayObservation`` (same members).",
      "required": [
        "assay_id",
        "lot_id",
        "ingredient_id",
        "measured_at_utc",
        "measured_at_s",
        "measurand",
        "value_percent",
        "sd_percent",
        "site",
        "method",
        "laboratory",
        "note"
      ],
      "properties": {
        "assay_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "lot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "ingredient_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "measured_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "measured_at_s": {
          "type": "number",
          "minimum": 0
        },
        "measurand": {
          "enum": [
            "total",
            "active"
          ]
        },
        "value_percent": {
          "type": "number"
        },
        "sd_percent": {
          "type": "number"
        },
        "site": {
          "enum": [
            "onboard",
            "ground"
          ]
        },
        "method": {
          "type": "string"
        },
        "laboratory": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "Expectation": {
      "type": "object",
      "additionalProperties": false,
      "description": "An assertion the scenario tests make about engine output at ``as_of_utc``. Members that a kind does not use are null or empty. Acceptance rules: spec section 15.4.",
      "required": [
        "expectation_id",
        "kind",
        "lot_id",
        "ingredient_id",
        "as_of_utc",
        "values",
        "lower",
        "upper",
        "other_lot_id",
        "rationale"
      ],
      "properties": {
        "expectation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "kind": {
          "enum": [
            "state_in",
            "flag_present",
            "flag_absent",
            "estimate_basis_in",
            "forecast_status_in",
            "lower_quantile_between",
            "coverage_low_is",
            "ordered_before",
            "true_potency_within_interval"
          ]
        },
        "lot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "ingredient_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "as_of_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "other_lot_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "InspectionRecord": {
      "type": "object",
      "additionalProperties": false,
      "description": "JSON form of ``InspectionObservation`` (same members).",
      "required": [
        "inspection_id",
        "lot_id",
        "inspected_at_utc",
        "inspected_at_s",
        "finding",
        "inspector_role",
        "note"
      ],
      "properties": {
        "inspection_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "lot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "inspected_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "inspected_at_s": {
          "type": "number",
          "minimum": 0
        },
        "finding": {
          "enum": [
            "no_change",
            "color_change",
            "cracking",
            "crystals",
            "cloudiness",
            "precipitate",
            "particles",
            "swollen_package",
            "phase_separation",
            "other"
          ]
        },
        "inspector_role": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "ScenarioEvent": {
      "type": "object",
      "additionalProperties": false,
      "description": "A scripted event. thermal_control_failure uses ``template_id`` from environment-profiles.json thermal_failure_templates; solar_particle_event uses an SPE template and ``shielding_scale`` multiplies its total dose; sensor_outage silences ``sensor_ids`` for ``duration_s``.",
      "required": [
        "event_id",
        "kind",
        "zone_id",
        "start_utc",
        "duration_s",
        "template_id",
        "sensor_ids",
        "shielding_scale",
        "note"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "kind": {
          "enum": [
            "thermal_control_failure",
            "solar_particle_event",
            "sensor_outage",
            "light_exposure_change"
          ]
        },
        "zone_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "start_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "template_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sensor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        },
        "shielding_scale": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "ScenarioMission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "name",
        "start_utc",
        "end_utc",
        "seed",
        "description"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "start_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "end_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "seed": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "ScenarioSensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensor_id",
        "quantity",
        "sampling_interval_s"
      ],
      "properties": {
        "sensor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "quantity": {
          "enum": [
            "temperature_k",
            "relative_humidity",
            "dose_rate_gy_per_s",
            "illuminance_lux",
            "uv_w_per_m2"
          ]
        },
        "sampling_interval_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ScenarioZone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone_id",
        "profile_id",
        "sensors",
        "seed_label"
      ],
      "properties": {
        "zone_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "sensors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioSensor"
          }
        },
        "seed_label": {
          "type": "string"
        }
      }
    }
  }
}
