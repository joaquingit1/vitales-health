{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crew-health-check.invalid/schemas/pharmacy/sources.schema.json",
  "title": "Source register: every source ID any document cites.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "schema",
    "version",
    "review_state",
    "notice",
    "sources"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "schema": {
      "const": "pharmacy/sources.schema.json"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "review_state": {
      "enum": [
        "draft",
        "reviewed",
        "approved"
      ]
    },
    "notice": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceEntry"
      }
    }
  },
  "$defs": {
    "SourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "citation",
        "url",
        "status",
        "note_file"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string"
        },
        "note_file": {
          "type": "string"
        }
      }
    }
  }
}
