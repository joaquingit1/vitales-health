{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crew-health-check.invalid/schemas/pharmacy/lots.schema.json",
  "title": "Lots in inventory with custody and package history.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "schema",
    "version",
    "review_state",
    "notice",
    "lots"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "schema": {
      "const": "pharmacy/lots.schema.json"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "review_state": {
      "enum": [
        "draft",
        "reviewed",
        "approved"
      ]
    },
    "notice": {
      "type": "string"
    },
    "lots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LotDoc"
      }
    }
  },
  "$defs": {
    "CustodyInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone_id",
        "from_utc",
        "to_utc"
      ],
      "properties": {
        "zone_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "from_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "to_utc": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "InitialAssay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingredient_id",
        "mean_percent",
        "sd_percent"
      ],
      "properties": {
        "ingredient_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "mean_percent": {
          "$ref": "common.schema.json#/$defs/SourcedValue"
        },
        "sd_percent": {
          "$ref": "common.schema.json#/$defs/SourcedValue"
        }
      }
    },
    "LotDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lot_id",
        "product_id",
        "manufacturer_lot",
        "manufactured_at_utc",
        "labeled_expiry_utc",
        "quantity",
        "initial_assay",
        "custody",
        "package_history",
        "status",
        "basis",
        "source_ids",
        "note"
      ],
      "properties": {
        "lot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "product_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "manufacturer_lot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "manufactured_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "labeled_expiry_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "quantity": {
          "$ref": "#/$defs/LotQuantity"
        },
        "initial_assay": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InitialAssay"
          }
        },
        "custody": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CustodyInterval"
          }
        },
        "package_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageInterval"
          }
        },
        "status": {
          "enum": [
            "active",
            "recalled",
            "consumed"
          ]
        },
        "basis": {
          "enum": [
            "sourced",
            "derived",
            "team_default"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/SourceId"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "enum": [
                  "sourced",
                  "derived"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "source_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "LotQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "PackageInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "from_utc"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "from_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        }
      }
    }
  }
}
