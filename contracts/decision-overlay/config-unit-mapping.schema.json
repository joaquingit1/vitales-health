{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config-unit-mapping.schema.json",
  "title": "unit-mapping.json",
  "type": "object",
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "mappings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "indicator_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "wire_unit": {"type": "string", "minLength": 1},
          "ucum_unit": {"type": "string", "minLength": 1},
          "conversion": {"enum": ["identity", "scale", "ppm_to_mmhg"]},
          "factor": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"},
          "rounding": {
            "type": "object", "properties": {"decimal_places": {"const": 4}, "mode": {"const": "half_even"}},
            "required": ["decimal_places", "mode"], "additionalProperties": false
          },
          "basis": {"const": "sourced"},
          "source_refs": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "properties": {
                "path": {"type": "string", "minLength": 1},
                "line": {"type": "integer", "minimum": 1},
                "decision": {"const": "D12"}
              }, "required": ["path", "line", "decision"], "additionalProperties": false
            }
          }
        },
        "required": ["indicator_code", "wire_unit", "ucum_unit", "conversion", "factor", "rounding", "basis", "source_refs"],
        "additionalProperties": false,
        "allOf": [
          {"if": {"properties": {"conversion": {"const": "scale"}}}, "then": {"properties": {"factor": {"type": "string"}}}, "else": {"properties": {"factor": {"type": "null"}}}},
          {"if": {"properties": {"conversion": {"const": "ppm_to_mmhg"}}}, "then": {"properties": {"wire_unit": {"const": "ppm"}, "ucum_unit": {"const": "[ppm]"}}}}
        ]
      }
    }
  },
  "required": ["version", "mappings"],
  "additionalProperties": false
}
